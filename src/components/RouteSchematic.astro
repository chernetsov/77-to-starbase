---
// Not to scale. Mileages are approximate cumulative road miles from Austin.
const stops = [
  { x: 90, y: 50, name: 'Austin', mi: 0, note: 'Pickup · AUS', side: 'right', key: true },
  { x: 150, y: 130, name: 'Lockhart', mi: 30, note: 'BBQ capital of Texas', side: 'left', below: true },
  { x: 230, y: 170, name: 'Luling', mi: 45, note: "World's largest Buc-ee's", side: 'right', key: true },
  { x: 320, y: 240, name: 'Cuero', mi: 90, note: '', side: 'left', below: true },
  { x: 420, y: 270, name: 'Victoria', mi: 120, note: 'Join US-77 · charge', side: 'right', key: true },
  { x: 600, y: 330, name: 'Kingsville', mi: 230, note: 'King Ranch saddle shop', side: 'right', below: true, key: true },
  { x: 800, y: 345, name: 'Raymondville', mi: 300, note: 'Ranch land, big sky, few towns', side: 'right' },
  { x: 930, y: 362, name: 'Brownsville', mi: 350, note: 'TX-4 east', side: 'right', below: true },
  { x: 1060, y: 372, name: 'Starbase', mi: 372, note: 'End of the road', side: 'right', key: true },
];
const d = stops.map((s, i) => `${i === 0 ? 'M' : 'L'}${s.x},${s.y}`).join(' ');
---

<svg class="schematic" viewBox="0 0 1200 440" role="img" aria-labelledby="route-title route-desc">
  <title id="route-title">Ground track from Austin to Starbase</title>
  <desc id="route-desc">
    A not-to-scale diagram of the roughly 370-mile drive: Austin, Lockhart, Luling, Cuero, Victoria, then US-77
    through Kingsville, Raymondville, and Brownsville, ending at Starbase on the Gulf coast.
  </desc>
  <defs>
    <linearGradient id="track" x1="0" x2="1">
      <stop offset="0" stop-color="#f2f2f2" />
      <stop offset="1" stop-color="#e8622c" />
    </linearGradient>
  </defs>

  <g stroke="#1c1c1f" stroke-width="1">
    {Array.from({ length: 13 }, (_, i) => <line x1={i * 100} y1="0" x2={i * 100} y2="440" />)}
    {Array.from({ length: 5 }, (_, i) => <line x1="0" y1={i * 100 + 20} x2="1200" y2={i * 100 + 20} />)}
  </g>

  <path d="M640,440 C760,425 900,412 1000,402 C1050,396 1080,330 1105,240 C1125,160 1160,80 1200,20"
        fill="none" stroke="#3a6b8c" stroke-width="1.5" stroke-dasharray="6 6" />
  <text x="1150" y="300" fill="#3a6b8c" font-family="JetBrains Mono" font-size="12" letter-spacing="3">GULF</text>

  <path d={d} fill="none" stroke="url(#track)" stroke-width="3" />
  <path d={d} fill="none" stroke="#000" stroke-width="3" stroke-dasharray="2 18" opacity="0.6" />

  <text x="470" y="308" fill="#e8622c" font-family="JetBrains Mono" font-size="12" letter-spacing="2"
        transform="rotate(18 470 308)">US-77 ▸</text>

  {stops.map((s) => (
    <g>
      <circle cx={s.x} cy={s.y} r={s.key ? 7 : 4} fill={s.key ? '#000' : '#f2f2f2'}
              stroke={s.name === 'Starbase' ? '#e8622c' : '#f2f2f2'} stroke-width="2" />
      <g text-anchor={s.side === 'left' ? 'end' : 'start'}
         transform={`translate(${s.x + (s.side === 'left' ? -14 : 14)}, ${s.y + (s.below ? 44 : -14)})`}>
        <text font-family="Barlow Condensed" font-size="20" font-weight="500" fill="#f2f2f2"
              letter-spacing="2">{s.name.toUpperCase()}</text>
        <text y="-22" font-family="JetBrains Mono" font-size="11" fill="#8d8d93">MI {String(s.mi).padStart(3, '0')}</text>
        {s.note && <text y="18" font-family="Barlow" font-size="13" fill="#8d8d93">{s.note}</text>}
      </g>
    </g>
  ))}

  <text x="24" y="425" font-family="JetBrains Mono" font-size="11" fill="#55555b" letter-spacing="2">
    SCHEMATIC · NOT TO SCALE · ≈370 MI · ≈6 H DRIVE TIME + STOPS
  </text>
</svg>
