---
let seed = 77;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: 90 }, () => ({
  x: rand() * 1400,
  y: rand() * 420,
  r: rand() > 0.88 ? 1.3 : 0.6,
  o: 0.25 + rand() * 0.55,
}));
---

<svg class="hero-art" viewBox="0 0 1400 620" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000" />
      <stop offset="0.7" stop-color="#0a0604" />
      <stop offset="1" stop-color="#3a1608" />
    </linearGradient>
    <linearGradient id="steel" x1="0" x2="1">
      <stop offset="0" stop-color="#7d8086" />
      <stop offset="0.45" stop-color="#e3e5e8" />
      <stop offset="1" stop-color="#6c6f74" />
    </linearGradient>
    <radialGradient id="sun" cx="0.5" cy="1" r="0.6">
      <stop offset="0" stop-color="#e8622c" stop-opacity="0.55" />
      <stop offset="1" stop-color="#e8622c" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1400" height="620" fill="url(#sky)" />
  <ellipse cx="980" cy="560" rx="700" ry="200" fill="url(#sun)" />
  {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" opacity={s.o} />)}

  <g transform="translate(1020 560)">
    <rect x="-34" y="-420" width="26" height="420" fill="none" stroke="#3a3a3f" stroke-width="2" />
    {Array.from({ length: 14 }, (_, i) => (
      <path d={`M-34,${-i * 30} L-8,${-i * 30 - 30} M-8,${-i * 30} L-34,${-i * 30 - 30}`} stroke="#2a2a2f" stroke-width="1" />
    ))}
    <path d="M-8,-300 L60,-312 M-8,-286 L60,-298" stroke="#55555b" stroke-width="3" />
    <rect x="6" y="-404" width="34" height="404" fill="url(#steel)" />
    <path d="M6,-404 C6,-440 23,-462 23,-462 C23,-462 40,-440 40,-404 Z" fill="url(#steel)" />
    <line x1="6" y1="-176" x2="40" y2="-176" stroke="#3a3a3f" stroke-width="2" />
    <rect x="2" y="-410" width="6" height="22" fill="#8a8d92" />
    <rect x="38" y="-410" width="6" height="22" fill="#8a8d92" />
  </g>

  <rect y="560" width="1400" height="60" fill="#000" />
  <line x1="0" y1="560" x2="1400" y2="560" stroke="#e8622c" stroke-width="1" opacity="0.6" />
  <path d="M0,600 L1400,575" stroke="#2a2a2f" stroke-width="1" stroke-dasharray="30 22" />

  <g transform="translate(680 598)">
    <polygon points="0,-8 0,-34 112,-58 184,-34 186,-14 180,-6" fill="url(#steel)" />
    <polygon points="70,-42 112,-55 150,-40" fill="#111" />
    <line x1="0" y1="-30" x2="184" y2="-32" stroke="#e8622c" stroke-width="1.5" opacity="0.9" />
    <circle cx="40" cy="-6" r="13" fill="#111" stroke="#55555b" stroke-width="2" />
    <circle cx="148" cy="-6" r="13" fill="#111" stroke="#55555b" stroke-width="2" />
    <line x1="186" y1="-28" x2="230" y2="-26" stroke="#fff" stroke-width="1" opacity="0.4" />
  </g>
</svg>

<style>
  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
</style>
