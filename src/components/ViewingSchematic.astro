  <text x="530" y="120" fill="#d9b67a" font-family="Barlow Condensed" font-size="16" letter-spacing="2"
        transform="rotate(-90 530 120)" text-anchor="middle">SOUTH PADRE ISLAND</text>

  <path d="M0,330 L590,316 L600,330 L600,470 L0,470 Z" fill="#1a1a1c" />
  <path d="M0,470 C150,455 300,490 450,470 C520,462 570,480 600,472" fill="none" stroke="#3a6b8c" stroke-width="2" />
  <text x="300" y="500" fill="#3a6b8c" font-family="JetBrains Mono" font-size="11" text-anchor="middle" letter-spacing="2">RIO GRANDE · MEXICO BELOW</text>

