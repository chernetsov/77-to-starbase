---
// Times follow the scene's own curves: altitude passes the 146 m tower at T+8, speed passes 343 m/s at T+30.2.
const events = [
  { at: -2.5, name: 'Ignition' },
  { at: 0, name: 'Liftoff' },
  { at: 8, name: 'Tower clear' },
  { at: 30.2, name: 'Mach 1' },
];
// Super Heavy's 33 Raptors: 3 centre, 10 inner ring, 20 outer ring.
const engines = [
  [3, 3.6],
  [10, 9.5],
  [20, 18],
].flatMap(([n, r], ring) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2 - Math.PI / 2 + ring * 0.16;
    return { x: +(r * Math.cos(a)).toFixed(2), y: +(r * Math.sin(a)).toFixed(2), ring };
  }),
);
const ARC = 'M8 44 Q220 -4 432 44';
---

<div class="stage" data-hero3d>
  <canvas aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>
  <div class="glare" aria-hidden="true"></div>
  <div class="floor" aria-hidden="true"></div>
  <div class="hud">
    <div class="arc" aria-hidden="true">
      <div class="arc-in">
        <svg viewBox="0 0 440 48">
          <path class="track" d={ARC} />
          <path class="progress" d={ARC} pathLength="1" />
          {events.map((e) => <circle class="mark" r="4.5" data-at={e.at} />)}
        </svg>
        {events.map((e) => <span class="hud-label mark-label">{e.name}</span>)}
      </div>
    </div>
    <div class="readout speed tele">
      <span class="hud-label">Speed</span>
      <span class="hud-value"><b data-vel>0</b><small>km/h</small></span>
    </div>
    <div class="clock">
      <span class="hud-value" data-t>T−00:10</span>
    </div>
    <div class="readout alt tele">
      <span class="hud-label">Altitude</span>
      <span class="hud-value"><b data-alt>0.0</b><small>km</small></span>
    </div>
    <figure class="readout engines" aria-hidden="true">
      <figcaption class="hud-label">Super Heavy</figcaption>
      <svg viewBox="-21 -21 42 42" data-engines data-lit="0">
        {engines.map((p) => <circle class={`r${p.ring}`} cx={p.x} cy={p.y} r="2.1" />)}
      </svg>
    </figure>
    <p class="hud-caption caption" data-caption aria-live="polite">
      View from Boca Chica Beach, the day before launch. Everything at true scale.
    </p>
    <div class="controls">
      <div class="chapters" role="group" aria-label="Intro scenes" data-chapters hidden>
        <button class="hud-btn chapter" type="button" data-chapter="site">Build site</button>
        <button class="hud-btn chapter" type="button" data-chapter="pad">Stacking</button>
        <button class="hud-btn chapter" type="button" data-chapter="beach">Beach</button>
        <button class="hud-btn chapter skip" type="button" data-skip>Skip</button>
      </div>
      <button class="hud-btn launch attn" type="button" data-launch disabled>Simulate launch</button>
      <button class="hud-btn sound" type="button" data-sound aria-pressed="true" disabled>Sound on</button>
    </div>
  </div>
  <div class="veil" aria-hidden="true"></div>
  <div class="gate" data-gate>
    <p class="hud-label gate-status" role="status" data-gate-status>Loading vehicle · 0%</p>
    <div class="gate-bar" aria-hidden="true"><i data-gate-bar></i></div>
    <div class="gate-actions" data-gate-actions hidden>
      <button class="hud-btn start" type="button" data-start>Start mission</button>
      <div class="gate-alt">
        <button class="gate-link" type="button" data-start-muted>Start muted</button>
        <button class="gate-link" type="button" data-gate-skip>Skip intro</button>
      </div>
      <p class="hud-caption gate-note" data-gate-note hidden>Sound off — toggle anytime</p>
    </div>
  </div>
</div>

<script>
  import type { LaunchAudio } from '../scripts/hero3d/audio';
  import type { Chapter } from '../scripts/hero3d/scene';

  const root = document.querySelector<HTMLElement>('[data-hero3d]')!;
  const canvas = root.querySelector('canvas')!;
  const btn = root.querySelector<HTMLButtonElement>('[data-launch]')!;
  const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]')!;
  const gateStatus = root.querySelector<HTMLElement>('[data-gate-status]')!;
  const gateBar = root.querySelector<HTMLElement>('[data-gate-bar]')!;
  const gateActions = root.querySelector<HTMLElement>('[data-gate-actions]')!;
  const gateNote = root.querySelector<HTMLElement>('[data-gate-note]')!;
  const startBtn = root.querySelector<HTMLButtonElement>('[data-start]')!;
  const startMutedBtn = root.querySelector<HTMLButtonElement>('[data-start-muted]')!;
  const gateSkipBtn = root.querySelector<HTMLButtonElement>('[data-gate-skip]')!;
  const chaptersEl = root.querySelector<HTMLElement>('[data-chapters]')!;
  const chapterBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-chapter]')];
  const skipBtn = root.querySelector<HTMLButtonElement>('[data-skip]')!;
  const caption = root.querySelector<HTMLElement>('[data-caption]')!;
  const tEl = root.querySelector<HTMLElement>('[data-t]')!;
  const altEl = root.querySelector<HTMLElement>('[data-alt]')!;
  const velEl = root.querySelector<HTMLElement>('[data-vel]')!;
  const enginesEl = root.querySelector<SVGSVGElement>('[data-engines]')!;
  const track = root.querySelector<SVGPathElement>('.track')!;
  const progress = root.querySelector<SVGPathElement>('.progress')!;
  const marks = [...root.querySelectorAll<SVGCircleElement>('.mark')];
  const labels = [...root.querySelectorAll<HTMLElement>('.mark-label')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const IGNITION = -2.5;
  const ARC_FROM = -10;
  const ARC_TO = 32;
  const eventAt = marks.map((m) => Number(m.dataset.at));
  const [, , TOWER_CLEAR, MACH_1] = eventAt;
  const IDLE_CAPTION = caption.textContent!.trim();

  if (!reduce) root.classList.add('intro');

  const arcK = (t: number) => Math.min(1, Math.max(0, (t - ARC_FROM) / (ARC_TO - ARC_FROM)));
  const fmt = (t: number) => {
    const s = Math.abs(t);
    const m = Math.floor(s / 60);
    return `T${t < 0 ? '−' : '+'}${String(m).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };

  function placeMarks() {
    const len = track.getTotalLength();
    track.style.setProperty('--len', `${len}px`);
    marks.forEach((m, i) => {
      const p = track.getPointAtLength(arcK(eventAt[i]) * len);
      m.setAttribute('cx', String(p.x));
      m.setAttribute('cy', String(p.y));
      m.style.setProperty('--from-mid', String(Math.abs(arcK(eventAt[i]) - 0.5) * 2));
      const l = labels[i];
      l.style.left = `${(p.x / 440) * 100}%`;
      l.style.top = `${(p.y / 48) * 100}%`;
      l.classList.toggle('edge-l', p.x < 70);
      l.classList.toggle('edge-r', p.x > 370);
    });
  }

  function captionFor(phase: string, t: number, soundDelay: number, padKm: string) {
    if (phase === 'idle') return IDLE_CAPTION;
    if (t < IGNITION) return 'Terminal count.';
    if (t < IGNITION + soundDelay) return 'Ignition. 33 Raptors.';
    if (t < TOWER_CLEAR) return `Sound arrives ${soundDelay.toFixed(1)} s after ignition, from ${padKm} km away.`;
    if (t < MACH_1) return 'Tower cleared.';
    return 'Mach 1.';
  }

  // The hero waits behind a loader until the scene is built and its shaders are warm, then a start button
  // begins the intro; that click is the user gesture that lets sound play. Turning sound off is remembered.
  // `?autostart` (and the dev aids `?t` / `?intro`) skip the gate and start silent; `?mute` forces sound off.
  const SOUND_KEY = '77-sound';
  const params = new URLSearchParams(location.search);
  const debugT = import.meta.env.DEV ? params.get('t') : null;
  const debugIntro = import.meta.env.DEV ? params.get('intro') : null;
  const autostart = params.has('autostart') || debugT !== null || debugIntro !== null;
  const soundPref = readSoundPref();
  let wantSound = !autostart && !params.has('mute') && soundPref;
  let audio: LaunchAudio | null = null;
  let gestured = false;
  function readSoundPref() {
    try {
      return localStorage.getItem(SOUND_KEY) !== 'off';
    } catch {
      return true;
    }
  }
  function showSound() {
    soundBtn.setAttribute('aria-pressed', String(wantSound));
    soundBtn.textContent = wantSound ? 'Sound on' : 'Sound off';
    soundBtn.title = wantSound && audio ? audio.nowPlaying : '';
  }
  function applySound() {
    showSound();
    if (!audio || !gestured || wantSound === audio.enabled) return;
    (wantSound ? audio.enable() : audio.disable()).catch((err) => console.warn('Audio unavailable', err));
  }
  showSound();
  soundBtn.addEventListener('click', () => {
    gestured = true;
    wantSound = !wantSound;
    try {
      if (wantSound) localStorage.removeItem(SOUND_KEY);
      else localStorage.setItem(SOUND_KEY, 'off');
    } catch {}
    applySound();
  });
  soundBtn.addEventListener('pointerenter', () => {
    if (audio?.enabled) soundBtn.title = audio.nowPlaying;
  });

  // Between real progress reports the bar creeps toward the end of the current step (never reaching it), so a
  // long shader compile on a phone doesn't read as stuck.
  let loaded = 0;
  let stepEnd = 0;
  let stepName = '';
  function paintLoad() {
    gateBar.style.transform = `scaleX(${loaded})`;
    gateStatus.textContent = `${stepName} · ${Math.round(loaded * 100)}%`;
  }
  function setLoad(step: string, k: number, end = k) {
    stepName = step;
    loaded = Math.max(loaded, Math.min(1, k));
    stepEnd = Math.max(loaded, Math.min(1, end));
    paintLoad();
  }
  const creep = setInterval(() => {
    if (stepEnd - loaded < 0.002) return;
    loaded += (stepEnd - loaded) * 0.04;
    paintLoad();
  }, 200);
  const nextFrame = () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

  async function boot() {
    if (!autostart) root.classList.add('gating');
    setLoad('Loading vehicle', 0);
    import('../scripts/hero3d/audio')
      .then(({ createLaunchAudio }) => {
        audio = createLaunchAudio();
        soundBtn.disabled = false;
        applySound();
      })
      .catch(() => soundBtn.remove());

    let hero: Awaited<ReturnType<typeof import('../scripts/hero3d/scene').createHeroScene>> | undefined;
    try {
      const sceneModule = import('../scripts/hero3d/scene');
      const { loadCybertruck } = await import('../scripts/hero3d/cybertruck');
      const truck = await loadCybertruck(undefined, (e) =>
        setLoad('Loading vehicle', 0.7 * (e.total ? e.loaded / e.total : 1 - Math.exp(-e.loaded / 2e6))),
      );
      setLoad('Building Starbase', 0.72, 0.8);
      const { createHeroScene, CHAPTERS, INTRO } = await sceneModule;
      await nextFrame();
      let lastPhase = 'idle';
      let lastUi = 0;
      const chapterStarts = chapterBtns.map((b) => CHAPTERS[b.dataset.chapter as Chapter]);
      let lastChapter = -2;
      hero = createHeroScene(canvas, truck, (h) => {
        if (!reduce) root.classList.toggle('intro', !h.introDone);
        const s = h.intro * INTRO.total;
        const chapter = h.introDone ? -1 : chapterStarts.findLastIndex((at) => s >= at);
        if (chapter !== lastChapter) {
          lastChapter = chapter;
          chapterBtns.forEach((b, i) => (i === chapter ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current')));
        }
        const soundDelay = hero?.soundDelay ?? 1.4;
        audio?.update(h, soundDelay);
        const run = h.phase !== 'idle';
        root.classList.toggle('run', run);
        root.classList.toggle('live', run && h.t >= IGNITION);
        root.classList.toggle('burn', run && h.t > -3);
        const clock = run ? fmt(h.t) : 'T−00:10';
        if (tEl.textContent !== clock) tEl.textContent = clock;

        const now = performance.now();
        if (now - lastUi < 100 && h.phase === lastPhase) return;
        lastUi = now;
        velEl.textContent = String(Math.round(h.vel * 3.6));
        altEl.textContent = (h.alt / 1000).toFixed(1);
        progress.style.strokeDashoffset = String(1 - (run ? arcK(h.t) : 0));
        let last = -1;
        marks.forEach((m, i) => {
          const passed = run && h.t >= eventAt[i];
          m.classList.toggle('passed', passed);
          if (passed) last = i;
        });
        const labelled = last >= 0 && h.t - eventAt[last] < 2 ? last : last + 1;
        labels.forEach((l, i) => l.classList.toggle('shown', run && i === labelled));
        enginesEl.dataset.lit = String(run ? [0, 0.3, 0.6].filter((d) => h.t >= IGNITION + d).length : 0);
        const text = captionFor(h.phase, h.t, soundDelay, ((hero?.padDistance ?? 0) / 1000).toFixed(1));
        if (caption.textContent !== text) caption.textContent = text;

        if (h.phase !== lastPhase) {
          lastPhase = h.phase;
          btn.disabled = run;
          if (!run && reduce) hero?.stop();
        }
      });
      setLoad('Priming engines', 0.8, 1);
      await hero.warmup((k) => setLoad('Priming engines', 0.8 + 0.2 * k, 1));
      clearInterval(creep);
    } catch (err) {
      clearInterval(creep);
      console.warn('3D hero unavailable', err);
      root.classList.remove('intro', 'gating');
      root.classList.add('fallback');
      return;
    }
    const h = hero;
    placeMarks();

    /** Starts the intro from frame 0 (or the settled view); `sound` comes from the click that started it. */
    function begin(sound: boolean, skip: boolean) {
      document.removeEventListener('keydown', onGateKey);
      const hadFocus = gateActions.contains(document.activeElement);
      root.classList.remove('gating', 'armed');
      gestured = true;
      wantSound = sound;
      applySound();
      if (reduce || skip) {
        root.classList.remove('intro');
        h.skipIntro();
        if (reduce) h.renderOnce();
      } else {
        h.seekIntro(0);
      }
      if (!reduce) chaptersEl.hidden = false;
      btn.disabled = false;
      if (hadFocus) (reduce || skip ? btn : skipBtn).focus({ preventScroll: true });
    }
    // Escape isn't a user activation, so sound chosen that way starts with the next click or key.
    function onGateKey(e: KeyboardEvent) {
      if (e.key !== 'Escape') return;
      begin(wantSound, true);
      const resume = () => wantSound && audio?.enable().catch(() => {});
      addEventListener('pointerdown', resume, { once: true, capture: true });
      addEventListener('keydown', resume, { once: true, capture: true });
    }

    if (reduce) h.renderOnce();
    else {
      h.holdIntro(0);
      h.start();
    }
    root.classList.add('ready');

    if (autostart) begin(false, false);
    else {
      startBtn.textContent = 'Start mission';
      startMutedBtn.hidden = !wantSound;
      gateNote.hidden = wantSound;
      gateStatus.hidden = true;
      gateActions.hidden = false;
      root.classList.add('armed');
      startBtn.addEventListener('click', () => begin(wantSound, false));
      startMutedBtn.addEventListener('click', () => begin(false, false));
      gateSkipBtn.addEventListener('click', () => begin(wantSound, true));
      document.addEventListener('keydown', onGateKey);
      startBtn.focus({ preventScroll: true });
    }

    if (debugIntro !== null) h.holdIntro(Number(debugIntro));
    if (debugT !== null) {
      root.classList.remove('intro');
      h.skipIntro();
      h.launch(Number(debugT));
      if (params.has('hold')) h.holdLaunch();
    }

    if (!reduce) {
      for (const b of chapterBtns) {
        b.addEventListener('click', () => {
          h.jumpToIntro(b.dataset.chapter as Chapter);
          h.start();
        });
      }
      skipBtn.addEventListener('click', () => h.skipIntro());
    }

    btn.addEventListener('click', () => {
      btn.classList.remove('attn');
      h.launch();
      h.start();
    });

    if (!reduce) {
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        h.pointer((e.clientX - r.left) / r.width - 0.5, (e.clientY - r.top) / r.height - 0.5);
      });
      root.addEventListener('pointerleave', () => h.pointer(0, 0));
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? h.start() : h.stop())).observe(root);
      document.addEventListener('visibilitychange', () => (document.hidden ? h.stop() : h.start()));
    }
  }

  boot();
</script>

<style>
  .stage, .stage ~ :global(.nav), .stage ~ :global(.hero-copy) {
    --gut: max(24px, calc((100vw - var(--max)) / 2 + 24px));
    --halo: 0 0 1px rgba(0, 0, 0, 0.6), 0 1px 4px rgba(0, 0, 0, 0.55), 0 0 14px rgba(0, 0, 0, 0.45), 0 0 32px rgba(0, 0, 0, 0.3);
    --halo-lg: 0 1px 2px rgba(0, 0, 0, 0.35), 0 2px 18px rgba(0, 0, 0, 0.35), 0 0 60px rgba(0, 0, 0, 0.3);
  }
  .stage {
    --hud-w: min(580px, 56vw);
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 60% at 70% 100%, #2a160c 0%, #000 70%);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .ready canvas { opacity: 1; }
  /* Scrims use eased multi-stop falloffs so they read as atmosphere, never as an edge. */
  .shade, .glare, .floor, .floor::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .shade {
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.84) 0%, rgba(0, 0, 0, 0.7) 22%, rgba(0, 0, 0, 0.5) 36%, rgba(0, 0, 0, 0.26) 48%,
        rgba(0, 0, 0, 0.09) 58%, rgba(0, 0, 0, 0) 66%
      ),
      linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.22) 9%, rgba(0, 0, 0, 0) 18%);
  }
  /* The hero can be taller than the viewport; the HUD and its floor scrim stay on the first screen. */
  .floor {
    bottom: auto;
    height: min(100%, 100svh);
    background:
      radial-gradient(
        calc(var(--hud-w) * 0.8) 240px at calc(100% - var(--gut) - var(--hud-w) / 2) 100%,
        rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.3) 45%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0) 100%
      ),
      linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.45) 14%, rgba(0, 0, 0, 0.16) 26%, rgba(0, 0, 0, 0) 34%);
  }
  /* Extra density while ignition steam and the plume light up the frame. */
  .glare, .floor::after {
    opacity: 0;
    transition: opacity 2.5s ease;
  }
  .glare {
    background: radial-gradient(
      70% 85% at 0% 58%,
      rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.36) 40%, rgba(0, 0, 0, 0.12) 72%, rgba(0, 0, 0, 0) 100%
    );
  }
  .floor::after {
    content: '';
    background: radial-gradient(
      calc(var(--hud-w) * 0.95) 300px at calc(100% - var(--gut) - var(--hud-w) / 2) 100%,
      rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.34) 45%, rgba(0, 0, 0, 0.12) 75%, rgba(0, 0, 0, 0) 100%
    );
  }
  .burn .glare, .burn .floor::after { opacity: 1; transition-duration: 1.5s; }

  .hud {
    position: absolute;
    z-index: 2;
    right: var(--gut);
    top: min(100%, 100svh);
    transform: translateY(calc(-100% - 22px));
    width: var(--hud-w);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas:
      '. arc .'
      'speed clock alt'
      'caption caption caption'
      'controls controls controls';
    column-gap: 32px;
    row-gap: 4px;
    align-items: end;
    text-shadow: var(--halo);
    transition: opacity 0.8s ease, visibility 0s;
  }
  .fallback .hud { display: none; }
  .hud svg { overflow: visible; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6)); }

  .arc { grid-area: arc; width: 320px; }
  .arc-in { position: relative; }
  .arc svg { display: block; width: 100%; height: auto; }
  .track, .progress { fill: none; stroke-linecap: round; }
  .track { stroke: var(--hud-line); stroke-width: 3; }
  .progress { stroke: var(--sunset); stroke-width: 4; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .mark { fill: rgba(10, 10, 12, 0.6); stroke: var(--hud-line); stroke-width: 2.5; transform-box: fill-box; transform-origin: center; }
  .mark.passed { fill: var(--hud-1); stroke: var(--hud-1); animation: pop 0.2s ease-out; }
  @keyframes pop { from { transform: scale(0.6); } }
  .mark-label {
    position: absolute;
    transform: translate(-50%, -100%) translateY(-10px);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mark-label.edge-l { transform: translate(-12px, -100%) translateY(-10px); }
  .mark-label.edge-r { transform: translate(calc(-100% + 12px), -100%) translateY(-10px); }
  .mark-label.shown { opacity: 1; }

  .readout { display: grid; gap: 6px; }
  .readout b { font-weight: inherit; }
  .speed { grid-area: speed; justify-self: end; justify-items: end; text-align: right; }
  .speed b { display: inline-block; min-width: 4ch; }
  .alt { grid-area: alt; justify-self: start; }
  .alt b { display: inline-block; min-width: 3ch; }
  .clock { grid-area: clock; justify-self: center; }
  .tele { opacity: 0; transition: opacity 0.4s ease; }
  .live .tele { opacity: 1; }

  .engines { grid-area: eng; margin: 0; justify-items: center; white-space: nowrap; display: none; }
  .engines svg { width: 40px; height: 40px; margin-bottom: -4px; }
  @media (min-width: 1200px) {
    .stage { --hud-w: min(680px, 56vw); }
    .hud {
      grid-template-columns: 1fr auto 1fr auto;
      grid-template-areas:
        '. arc . .'
        'speed clock alt eng'
        'caption caption caption .'
        'controls controls controls .';
    }
    .engines { display: grid; }
  }
  .engines circle { fill: transparent; stroke: var(--hud-line); stroke-width: 1; transition: fill 0.15s, stroke 0.15s; }
  [data-lit='1'] .r0,
  [data-lit='2'] :is(.r0, .r1),
  [data-lit='3'] circle { fill: var(--hud-1); stroke: var(--hud-1); }
  .arc, .engines { opacity: 0; transition: opacity 0.4s ease; }
  .run :is(.arc, .engines) { opacity: 1; }

  /* Webcast-style boot: every piece opens out from the middle of where it will sit. The arc grows from its
     midpoint to both ends, marks pop as the line reaches them, the engine map expands and runs a lamp test;
     at ignition the readouts open from their centres. */
  @media (prefers-reduced-motion: no-preference) {
    .run .track { animation: hud-draw 0.8s cubic-bezier(0.3, 0, 0.2, 1) both; }
    /* One dash, centred on the path, growing from nothing to the full length. */
    @keyframes hud-draw {
