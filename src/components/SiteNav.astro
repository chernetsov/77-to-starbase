---
const links = [
  { href: '#plan', label: 'Flight plan' },
  { href: '#manifest', label: 'Manifest' },
  { href: '#host', label: 'Host' },
  { href: '#crew', label: 'Join' },
];
---

<div class="nav-spacer" data-nav-sentinel aria-hidden="true"></div>
<nav class="site-nav" aria-label="Primary" data-site-nav>
  <div class="wrap inner">
    <a class="logo" href="#top" aria-label="77 to Starbase home">
      <span class="star" aria-hidden="true">★</span> 77<span class="slash">/</span>STARBASE
    </a>
    <div class="links" data-nav-links>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <span class="bar" aria-hidden="true"></span>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const sentinel = document.querySelector<HTMLElement>('[data-nav-sentinel]');
  const row = nav?.querySelector<HTMLElement>('[data-nav-links]');
  if (nav && sentinel && row) {
    const bar = row.querySelector<HTMLElement>('.bar')!;
    const links = [...row.querySelectorAll<HTMLAnchorElement>('a')];
    const sections = links
      .map((a) => document.querySelector<HTMLElement>(a.hash))
      .filter((s): s is HTMLElement => !!s);

    new IntersectionObserver(([e]) => nav.classList.toggle('scrolled', !e.isIntersecting), {
      rootMargin: '-8px 0px 0px 0px',
    }).observe(sentinel);

    const visible = new Set<Element>();
    let current: HTMLAnchorElement | null = null;

    const moveBar = () => {
      if (!current) return bar.classList.remove('on');
      bar.style.width = `${current.offsetWidth}px`;
      bar.style.transform = `translateX(${current.offsetLeft}px)`;
      bar.classList.add('on');
    };

    const setActive = (a: HTMLAnchorElement | null) => {
      if (a === current) return;
      current?.removeAttribute('aria-current');
      current = a;
      a?.setAttribute('aria-current', 'true');
      moveBar();
      if (a && row.scrollWidth > row.clientWidth) {
        row.scrollTo({ left: a.offsetLeft - (row.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' });
      }
    };

    const update = () => {
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const section = atBottom ? sections.at(-1) : sections.find((s) => visible.has(s));
      setActive(section ? links.find((a) => a.hash === `#${section.id}`) ?? null : null);
    };

    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
        update();
      },
      { rootMargin: '-35% 0px -64% 0px' },
    );
    sections.forEach((s) => spy.observe(s));

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => ((ticking = false), update()));
      },
      { passive: true },
    );
    addEventListener('resize', moveBar);
    document.fonts?.ready.then(moveBar);
  }
</script>

<style is:global>
  :root { --nav-h: 64px; }
  html { scroll-padding-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + 16px); }
</style>

<style>
  .nav-spacer { height: 56px; flex: none; }
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) 0 env(safe-area-inset-left, 0px);
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
  }
  .site-nav.scrolled {
    background: rgba(10, 10, 12, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgba(242, 242, 242, 0.08);
  }
  .inner {
    height: var(--nav-h);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    transform: translateY(8px);
    transition: transform 0.3s ease;
  }
  .scrolled .inner { transform: none; }
  .logo {
    flex: none;
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo .star, .logo .slash { color: var(--sunset); }
  .links { position: relative; display: flex; gap: 28px; }
  .links a {
    font: 500 var(--fs-label) var(--display);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--hud-2);
    text-decoration: none;
    white-space: nowrap;
    padding: 10px 0;
    transition: color 0.2s ease;
  }
  .links a:hover, .links a[aria-current] { color: var(--hud-1); }
  .bar {
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 2px;
    width: 0;
    background: var(--sunset);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1), width 0.35s cubic-bezier(0.3, 0.7, 0.2, 1), opacity 0.2s ease;
  }
  .bar.on { opacity: 1; }

  @media (max-width: 900px) {
    :global(:root) { --nav-h: 52px; }
    .nav-spacer { height: 44px; }
    .inner { gap: 12px; transform: translateY(4px); }
    .logo { font-size: 0.9rem; letter-spacing: 0.1em; }
    .links {
      gap: 14px;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 12px, #000 calc(100% - 12px), transparent);
      mask-image: linear-gradient(to right, transparent, #000 12px, #000 calc(100% - 12px), transparent);
      padding: 0 12px;
      margin-right: -12px;
    }
    .links::-webkit-scrollbar { display: none; }
    .links a { font-size: 0.72rem; letter-spacing: 0.1em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav, .inner, .bar, .links a { transition: none; }
  }
</style>
