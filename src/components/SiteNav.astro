---
const links = [
  { href: '#host', label: 'Host' },
  { href: '#plan', label: 'Flight plan', short: 'Plan' },
  { href: '#manifest', label: 'Manifest' },
  { href: '#crew', label: 'Join' },
];
const lab = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}lab/`;
const repo = import.meta.env.PUBLIC_REPO_URL || 'https://github.com/';
---

<div class="nav-spacer" data-nav-sentinel aria-hidden="true"></div>
<nav class="site-nav" aria-label="Primary" data-site-nav>
  <div class="wrap inner">
    <a class="logo" href="#top" aria-label="77 to Starbase home">
      <span class="star" aria-hidden="true">★</span> 77<span class="slash">/</span>STARBASE
    </a>
    <div class="links" data-nav-links>
      {
        links.map((l) =>
          l.short ? (
            <a href={l.href} aria-label={l.label}>
              <span class="long">{l.label}</span>
              <span class="short" aria-hidden="true">{l.short}</span>
            </a>
          ) : (
            <a href={l.href}>{l.label}</a>
          ),
        )
      }
      <span class="bar" aria-hidden="true"></span>
    </div>
    <div class="icons">
      <a href={lab} aria-label="Lab: inspect the 3D models, launch pad and soundtrack" title="Lab · inspect the 3D models">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 3h6M10 3v6.2L4.7 18.3A1.8 1.8 0 0 0 6.2 21h11.6a1.8 1.8 0 0 0 1.5-2.7L14 9.2V3" />
          <path d="M7.2 15.5h9.6" />
          <circle cx="11" cy="18" r="0.6" fill="currentColor" stroke="none" />
          <circle cx="13.6" cy="17.2" r="0.45" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href={repo} target="_blank" rel="noopener" aria-label="Source code on GitHub" title="Source on GitHub">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const sentinel = document.querySelector<HTMLElement>('[data-nav-sentinel]');
  const row = nav?.querySelector<HTMLElement>('[data-nav-links]');
  if (nav && sentinel && row) {
    const bar = row.querySelector<HTMLElement>('.bar')!;
    const links = [...row.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = links
      .map((a) => document.querySelector<HTMLElement>(a.hash))
      .filter((s): s is HTMLElement => !!s);

    new IntersectionObserver(([e]) => nav.classList.toggle('scrolled', !e.isIntersecting), {
      rootMargin: '-8px 0px 0px 0px',
    }).observe(sentinel);

    const visible = new Set<Element>();
    let current: HTMLAnchorElement | null = null;

    const moveBar = () => {
      if (!current) return bar.classList.remove('on');
      bar.style.width = `${current.offsetWidth}px`;
      bar.style.transform = `translateX(${current.offsetLeft}px)`;
      bar.classList.add('on');
    };

    const setActive = (a: HTMLAnchorElement | null) => {
      if (a === current) return;
      current?.removeAttribute('aria-current');
      current = a;
      a?.setAttribute('aria-current', 'true');
      moveBar();
      if (a && row.scrollWidth > row.clientWidth) {
        row.scrollTo({ left: a.offsetLeft - (row.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' });
      }
    };

    const update = () => {
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const section = atBottom ? sections.at(-1) : sections.find((s) => visible.has(s));
      setActive(section ? links.find((a) => a.hash === `#${section.id}`) ?? null : null);
    };

    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
        update();
      },
      { rootMargin: '-35% 0px -64% 0px' },
    );
    sections.forEach((s) => spy.observe(s));

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => ((ticking = false), update()));
      },
      { passive: true },
    );
    addEventListener('resize', moveBar);
    document.fonts?.ready.then(moveBar);
  }
</script>

<style is:global>
  :root { --nav-h: 64px; }
  html { scroll-padding-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + 16px); }
</style>

<style>
  .nav-spacer { height: 56px; flex: none; }
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) 0 env(safe-area-inset-left, 0px);
    border-bottom: 1px solid transparent;
    text-shadow: 0 0 1px rgba(0, 0, 0, 0.6), 0 1px 4px rgba(0, 0, 0, 0.55), 0 0 14px rgba(0, 0, 0, 0.45), 0 0 32px rgba(0, 0, 0, 0.3);
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease, text-shadow 0.3s ease;
  }
  .site-nav.scrolled {
    text-shadow: none;
    background: rgba(10, 10, 12, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgba(242, 242, 242, 0.08);
  }
  .inner {
    height: var(--nav-h);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    transform: translateY(8px);
    transition: transform 0.3s ease;
  }
  .scrolled .inner { transform: none; }
  .logo {
    flex: none;
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo .star, .logo .slash { color: var(--sunset); }
  .links { position: relative; display: flex; gap: 28px; }
  .links a {
    font: 500 var(--fs-label) var(--display);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: rgba(242, 242, 242, 0.72);
    text-decoration: none;
    white-space: nowrap;
    padding: 10px 0;
    transition: color 0.2s ease;
  }
  .links a:hover, .links a[aria-current] { color: #fff; }
  .links { margin-left: auto; }
  .icons {
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
    margin-left: -6px;
    padding-left: 16px;
  }
  .icons::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    height: 14px;
    width: 1px;
    background: rgba(242, 242, 242, 0.25);
    transform: translateY(-50%);
  }
  .links .short { display: none; }
  .icons a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: rgba(242, 242, 242, 0.72);
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6));
    transition: color 0.2s ease;
  }
  .icons a:hover, .icons a:focus-visible { color: var(--sunset); }
  .icons svg { width: 18px; height: 18px; }
  .icons a:first-child svg { width: 20px; height: 20px; }
  .bar {
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 2px;
    width: 0;
    background: var(--sunset);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1), width 0.35s cubic-bezier(0.3, 0.7, 0.2, 1), opacity 0.2s ease;
  }
  .bar.on { opacity: 1; }

  @media (max-width: 900px) {
    :global(:root) { --nav-h: 52px; }
    .nav-spacer { height: 44px; }
    .inner { gap: 12px; transform: translateY(4px); }
    .logo { font-size: 0.9rem; letter-spacing: 0.1em; }
    .links {
      gap: 11px;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 12px, #000 calc(100% - 12px), transparent);
      mask-image: linear-gradient(to right, transparent, #000 12px, #000 calc(100% - 12px), transparent);
      padding: 0 12px;
      margin-right: -12px;
    }
    .links::-webkit-scrollbar { display: none; }
    .links a { font-size: 0.72rem; letter-spacing: 0.07em; }
    .icons { gap: 0; margin-left: -10px; padding-left: 6px; }
  }
  @media (max-width: 480px) {
    .links .long { display: none; }
    .links .short { display: inline; }
    .icons a { width: 28px; }
    .icons svg { width: 16px; height: 16px; }
    .icons a:first-child svg { width: 18px; height: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav, .inner, .bar, .links a { transition: none; }
  }
</style>
