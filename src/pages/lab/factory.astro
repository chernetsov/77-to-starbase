---
import Base from '../../layouts/Base.astro';
---

<Base title="Build site lab · 77 to Starbase" description="Build site inspection">
  <meta slot="head" name="robots" content="noindex" />
  <main class="lab">
    <canvas data-lab></canvas>
    <div class="panel mono">
      <p class="title">Build site lab</p>
      <p class="hint">Drag to orbit · scroll to zoom · right-drag to pan. URL: ?view=beach|tele|close|aerial&amp;glow=0..1&amp;dusk</p>
      <div class="row">
        <button type="button" data-view="beach">Beach (hero lens)</button>
        <button type="button" data-view="tele">Beach telephoto</button>
        <button type="button" data-view="close">Close ¾</button>
        <button type="button" data-view="aerial">Aerial</button>
      </div>
      <div class="row">
        <label>Glow <input type="range" min="0" max="1" step="0.05" data-glow /></label>
      </div>
      <p class="stats" data-stats></p>
    </div>
  </main>
</Base>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { Sky } from 'three/addons/objects/Sky.js';
  import { buildBuildSite } from '../../scripts/hero3d/factory';

  const params = new URLSearchParams(location.search);
  const canvas = document.querySelector<HTMLCanvasElement>('[data-lab]')!;
  const stats = document.querySelector<HTMLElement>('[data-stats]')!;
  const glowInput = document.querySelector<HTMLInputElement>('[data-glow]')!;

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 0.62;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(32, 1, 0.5, 30000);
  const dusk = params.has('dusk');
  const sunDir = new THREE.Vector3().setFromSphericalCoords(1, THREE.MathUtils.degToRad(90 - (dusk ? -1.5 : 11)), THREE.MathUtils.degToRad(dusk ? 250 : 67));
  const sky = new Sky();
  sky.scale.setScalar(20000);
  Object.assign(sky.material.uniforms.turbidity, { value: 7 });
  sky.material.uniforms.rayleigh.value = 2.4;
  sky.material.uniforms.mieCoefficient.value = 0.006;
  sky.material.uniforms.mieDirectionalG.value = 0.86;
  sky.material.uniforms.sunPosition.value.copy(sunDir);
  scene.add(sky);
  const pmrem = new THREE.PMREMGenerator(renderer);
  const envScene = new THREE.Scene();
  const envSky = new Sky();
  envSky.scale.setScalar(1000);
  envSky.material.uniforms.sunPosition.value.copy(sunDir);
  envScene.add(envSky);
  scene.environment = pmrem.fromScene(envScene, 0.02).texture;
  scene.fog = new THREE.FogExp2(0xb8a995, 0.00011);
  const sun = new THREE.DirectionalLight(0xffd2a6, dusk ? 0.15 : 3.2);
  sun.position.copy(sunDir).multiplyScalar(1000);
  scene.add(sun);
  scene.add(new THREE.HemisphereLight(0xa9c2e0, 0x6e5a42, dusk ? 0.12 : 0.6));
  if (dusk) scene.environmentIntensity = 0.25;

  const ground = new THREE.Mesh(new THREE.PlaneGeometry(24000, 24000), new THREE.MeshStandardMaterial({ color: 0x9a8f6e, roughness: 1 }));
  ground.rotation.x = -Math.PI / 2;
  scene.add(ground);

  const site = buildBuildSite();
  scene.add(site);
  Object.assign(window, { site, camera });
  const glow = Number(params.get('glow') ?? (dusk ? 1 : 0.15));
  glowInput.value = String(glow);
  site.setGlow(glow);
  glowInput.addEventListener('input', () => site.setGlow(Number(glowInput.value)));

  // Same beach vantage as the hero scene.
  const BEACH = new THREE.Vector3(480, 2.4, -60);
  const center = site.position.clone().add(new THREE.Vector3(-120, 40, 0).applyAxisAngle(new THREE.Vector3(0, 1, 0), site.rotation.y));
  const controls = new OrbitControls(camera, canvas);
  controls.enableDamping = true;
  Object.assign(window, { controls });

  const views: Record<string, () => void> = {
    beach() {
      camera.fov = 32;
      camera.position.copy(BEACH);
      controls.target.set(0, 52, 0);
    },
    tele() {
      camera.fov = 4.5;
      camera.position.copy(BEACH);
      controls.target.copy(center).setY(45);
    },
    close() {
      camera.fov = 32;
      const off = new THREE.Vector3(420, 30, -260).applyAxisAngle(new THREE.Vector3(0, 1, 0), site.rotation.y);
      camera.position.copy(site.position).add(off);
      controls.target.copy(center).setY(35);
    },
    aerial() {
      camera.fov = 32;
      const off = new THREE.Vector3(700, 520, -420).applyAxisAngle(new THREE.Vector3(0, 1, 0), site.rotation.y);
      camera.position.copy(site.position).add(off);
      controls.target.copy(center).setY(0);
    },
  };
  function setView(name: string) {
    (views[name] ?? views.close)();
    camera.updateProjectionMatrix();
    controls.update();
    document.querySelectorAll('[data-view]').forEach((b) => b.classList.toggle('on', (b as HTMLElement).dataset.view === name));
  }
  document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
  setView(params.get('view') ?? 'close');

  function resize() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(canvas);
  resize();

  renderer.setAnimationLoop(() => {
    controls.update();
    renderer.render(scene, camera);
    const d = camera.position.distanceTo(site.position);
    stats.textContent = `${renderer.info.render.calls} draw calls · ${(renderer.info.render.triangles / 1000).toFixed(1)}k tris · ${Math.round(d)} m to site`;
  });
</script>

<style>
  .lab { position: fixed; inset: 0; }
  canvas { width: 100%; height: 100%; display: block; }
  .panel {
    position: absolute;
    top: 20px;
    left: 20px;
    max-width: 380px;
    display: grid;
    gap: 10px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid #2a2b30;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .panel p { margin: 0; }
  .title { color: var(--text); letter-spacing: 0.18em; text-transform: uppercase; }
  .row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  button {
    font: inherit;
    color: var(--text);
    background: #1c1d22;
    border: 1px solid #34363c;
    padding: 6px 10px;
    cursor: pointer;
  }
  button.on { border-color: var(--sunset); color: var(--sunset); }
  .stats { color: var(--text); }
</style>
