---
import Base from '../../layouts/Base.astro';
---

<Base title="Audio lab · 77 to Starbase" description="Launch soundtrack test bench">
  <meta slot="head" name="robots" content="noindex" />
  <main class="lab mono">
    <p class="title">Audio lab</p>
    <p class="hint">Idle: Drifter ⇄ Space Atmosphere with 4 s crossfades (generative loop as fallback). Launch: countdown riser, then the roar arrives 1.4 s after ignition (480 m away).</p>
    <div class="row">
      <button type="button" data-enable>Enable sound</button>
      <button type="button" data-mute disabled>Mute</button>
      <button type="button" data-next disabled>Next track</button>
      <button type="button" data-launch>Simulate launch</button>
    </div>
    <div class="telemetry">
      <span><b data-now>Sound off</b><i>Now playing</i></span>
      <span><b data-level>—</b><i>Output dBFS</i></span>
    </div>
    <div class="telemetry">
      <span><b data-clock>—</b><i>Clock</i></span>
      <span><b data-phase>idle</b><i>Phase</i></span>
      <span><b data-alt>0</b><i>Alt m</i></span>
      <span><b data-vel>0</b><i>Vel km/h</i></span>
      <span><b data-heard>—</b><i>Sound</i></span>
    </div>
    <div class="row">
      <button type="button" data-offline>Offline render check (66 s, generative fallback)</button>
      <a data-wav hidden download="launch-audio.wav">Download WAV</a>
    </div>
    <pre data-report></pre>
  </main>
</Base>

<script>
  import { createLaunchAudio, type LaunchHud } from '../../scripts/hero3d/audio';

  const SOUND_DELAY = 1.4;
  const q = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const enableBtn = q<HTMLButtonElement>('[data-enable]');
  const muteBtn = q<HTMLButtonElement>('[data-mute]');
  const nextBtn = q<HTMLButtonElement>('[data-next]');
  const launchBtn = q<HTMLButtonElement>('[data-launch]');
  const report = q('[data-report]');

  const hudAt = (t: number | null): LaunchHud => {
    if (t === null || t > 32) return { phase: 'idle', t: 0, alt: 0, vel: 0 };
    const f = Math.max(0, t);
    return { phase: t < 0 ? 'countdown' : 'flight', t, alt: 1.6 * f * f + 0.09 * f ** 3, vel: 3.2 * f + 0.27 * f * f };
  };
  const fmt = (t: number) => `T${t < 0 ? '-' : '+'}${Math.abs(t).toFixed(1).padStart(4, '0')}`;

  // ?fallback points the playlist at a missing file to exercise the generative fallback.
  const audio = createLaunchAudio(
    new URLSearchParams(location.search).has('fallback')
      ? { tracks: [{ url: `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}audio/missing.m4a`, title: 'Missing', artist: 'nobody' }] }
      : {},
  );
  (window as unknown as { __lab: unknown }).__lab = { audio, launch: () => launchBtn.click() };
  let simStart: number | null = null;
  let meter = -Infinity;

  nextBtn.addEventListener('click', () => audio.next());

  enableBtn.addEventListener('click', async () => {
    if (audio.enabled) {
      await audio.disable();
      enableBtn.textContent = 'Enable sound';
      muteBtn.disabled = true;
    } else {
      await audio.enable();
      enableBtn.textContent = 'Disable sound';
      muteBtn.disabled = false;
    }
  });
  muteBtn.addEventListener('click', () => {
    audio.setMuted(!audio.muted);
    muteBtn.textContent = audio.muted ? 'Unmute' : 'Mute';
  });
  launchBtn.addEventListener('click', () => {
    if (!audio.enabled) {
      audio.enable();
      enableBtn.textContent = 'Disable sound';
      muteBtn.disabled = false;
    }
    if (simStart === null) simStart = performance.now() / 1000 + 10;
  });

  function frame() {
    const t = simStart === null ? null : performance.now() / 1000 - simStart;
    const h = hudAt(t);
    if (h.phase === 'idle') simStart = null;
    audio.update(h, SOUND_DELAY);
    launchBtn.disabled = h.phase !== 'idle';
    nextBtn.disabled = !audio.enabled || h.phase !== 'idle';
    q('[data-now]').textContent = audio.nowPlaying;
    const lv = audio.levelDb;
    meter = Number.isFinite(lv) ? Math.max(lv, meter - 0.4) : -Infinity;
    q('[data-level]').textContent = Number.isFinite(meter) && meter > -90 ? meter.toFixed(1) : '—';
    q('[data-clock]').textContent = h.phase === 'idle' ? 'T-10.0' : fmt(h.t);
    q('[data-phase]').textContent = h.phase;
    q('[data-alt]').textContent = h.alt.toFixed(0);
    q('[data-vel]').textContent = String(Math.round(h.vel * 3.6));
    const heard = h.t + 2.5 - SOUND_DELAY;
    q('[data-heard]').textContent = h.phase === 'idle' ? '—' : heard < 0 ? `in ${(-heard).toFixed(1)} s` : 'roar';
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  function wav(buf: AudioBuffer) {
    const n = buf.length;
    const view = new DataView(new ArrayBuffer(44 + n * 4));
    const str = (o: number, s: string) => [...s].forEach((c, i) => view.setUint8(o + i, c.charCodeAt(0)));
    str(0, 'RIFF');
    view.setUint32(4, 36 + n * 4, true);
    str(8, 'WAVEfmt ');
    view.setUint32(16, 16, true);
    view.setUint16(20, 1, true);
    view.setUint16(22, 2, true);
    view.setUint32(24, buf.sampleRate, true);
    view.setUint32(28, buf.sampleRate * 4, true);
    view.setUint16(32, 4, true);
    view.setUint16(34, 16, true);
    str(36, 'data');
    view.setUint32(40, n * 4, true);
    const l = buf.getChannelData(0);
    const r = buf.getChannelData(1);
    for (let i = 0; i < n; i++) {
      view.setInt16(44 + i * 4, Math.max(-1, Math.min(1, l[i])) * 32767, true);
      view.setInt16(46 + i * 4, Math.max(-1, Math.min(1, r[i])) * 32767, true);
    }
    return new Blob([view], { type: 'audio/wav' });
  }

  async function offlineCheck() {
    report.textContent = 'Rendering…';
    const sr = 44100;
    const dur = 66;
    const launchAt = 12;
    const off = new OfflineAudioContext(2, sr * dur, sr);
    const a = createLaunchAudio({ context: off, tracks: [] });
    await a.enable();
    for (let i = 1; i < dur * 30; i++) {
      const time = i / 30;
      off.suspend(time).then(() => {
        a.update(hudAt(time < launchAt ? null : time - launchAt - 10), SOUND_DELAY);
        a.pump();
        off.resume();
      });
    }
    const buf = await off.startRendering();
    const l = buf.getChannelData(0);
    const r = buf.getChannelData(1);
    const db = (x: number) => (x > 0 ? (20 * Math.log10(x)).toFixed(1) : '-inf');
    const lines = [];
    let peak = 0;
    let clips = 0;
    let nan = 0;
    const win = sr * 2;
    for (let w = 0; w < buf.length; w += win) {
      let p = 0;
      let s = 0;
      let ds = 0;
      for (let i = w; i < Math.min(buf.length, w + win); i++) {
        const v = Math.max(Math.abs(l[i]), Math.abs(r[i]));
        if (i > 0) ds += (l[i] - l[i - 1]) ** 2;
        if (Number.isNaN(l[i]) || Number.isNaN(r[i])) nan++;
        if (v >= 0.999) clips++;
        p = Math.max(p, v);
        s += l[i] * l[i];
      }
      peak = Math.max(peak, p);
      const at = w / sr;
      const label = at < launchAt ? 'idle' : `sim t=${(at - launchAt - 10).toFixed(0).padStart(3)}`;
      lines.push(`${String(at).padStart(2)}s  ${label.padEnd(10)} peak ${db(p).padStart(6)} dBFS  rms ${db(Math.sqrt(s / win)).padStart(6)} dBFS  bright ${Math.sqrt(ds / (s || 1)).toFixed(3)}`);
    }
    const summary = { peakDb: Number(db(peak)), clips, nan };
    lines.unshift(`overall peak ${db(peak)} dBFS · clipped samples ${clips} · NaN ${nan}`, '');
    report.textContent = lines.join('\n');
    const link = q<HTMLAnchorElement>('[data-wav]');
    link.href = URL.createObjectURL(wav(buf));
    link.hidden = false;
    (window as unknown as { __audioReport: unknown }).__audioReport = { summary, lines };
  }
  q('[data-offline]').addEventListener('click', offlineCheck);
  if (new URLSearchParams(location.search).has('offline')) offlineCheck();
</script>

<style>
  .lab {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 24px;
    display: grid;
    gap: 20px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title { margin: 0; color: var(--text); font-size: 1rem; }
  .hint { margin: 0; text-transform: none; letter-spacing: 0.02em; font-size: 0.85rem; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  button, a {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: 10px 16px;
    cursor: pointer;
    text-decoration: none;
  }
  button:hover:not(:disabled), a:hover { border-color: var(--sunset); color: var(--sunset); }
  button:disabled { color: #555; cursor: default; }
  .telemetry { display: flex; gap: 28px; flex-wrap: wrap; }
  .telemetry span { display: grid; }
  .telemetry b { color: var(--text); font-size: 1.4rem; font-weight: 600; letter-spacing: 0.06em; }
  .telemetry i { font-style: normal; font-size: 0.65rem; }
  pre { margin: 0; text-transform: none; letter-spacing: 0; font-size: 0.75rem; color: var(--steel); white-space: pre-wrap; }
</style>
