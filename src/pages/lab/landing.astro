---
import Base from '../../layouts/Base.astro';

const lab = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}lab/`;
---

<Base title="Landing lab · 77 to Starbase" description="The ship's descent and catch as a rigid-body simulation">
  <meta slot="head" name="robots" content="noindex" />
  <main class="landing-lab mono">
    <header class="bar">
      <a class="back" href={lab}>← Lab</a>
      <span class="title">Landing lab</span>
      <span class="result" data-summary>
        <b data-s="verdict">—</b>
        <span title="Seconds from the burn when the pins meet the rails">contact <b data-s="contact">—</b> s</span>
        <span title="Downward / sideways speed at contact">at <b data-s="speed">—</b> m/s</span>
        <span title="Engine shutdowns, seconds from the burn">cuts <b data-s="cuts">—</b></span>
        <span title="Largest gimbal angle, and seconds spent on the ±15° stops">gimbal <b data-s="gim">—</b>°, <b data-s="stops">—</b> s on stops</span>
        <span title="Propellant burned">used <b data-s="prop">—</b> t</span>
      </span>
      <button type="button" data-drawer-open aria-expanded="false" aria-controls="landing-params">Parameters</button>
    </header>

    <div class="stage">
      <figure class="view">
        <div class="cv"><canvas data-view="side"></canvas></div>
        <figcaption>From the beach · 500 m grid · loupe on the ship</figcaption>
      </figure>
      <figure class="view">
        <div class="cv"><canvas data-view="close"></canvas></div>
        <figcaption>Close-up from the beach · true scale · 20 m grid</figcaption>
        <dl class="readouts">
          <div><dt>T</dt><dd data-r="t">—</dd></div>
          <div><dt>Alt</dt><dd data-r="alt">—</dd></div>
          <div><dt>Speed</dt><dd data-r="v">—</dd></div>
          <div><dt>Accel</dt><dd data-r="g">—</dd></div>
          <div><dt>Throttle</dt><dd data-r="thr">—</dd></div>
          <div><dt>Pitch</dt><dd data-r="pitch">—</dd></div>
          <div><dt>Gimbal</dt><dd data-r="gim">—</dd></div>
        </dl>
      </figure>
      <figure class="view">
        <div class="cv"><canvas data-view="top"></canvas></div>
        <figcaption>From above · north up · 100 m grid · loupe on the ship</figcaption>
      </figure>
    </div>

    <div class="transport">
      <button type="button" data-play>Pause</button>
      <input type="range" data-scrub min="0" max="1" step="0.001" value="0" aria-label="Time" />
      <button type="button" data-rate>1×</button>
      <button type="button" data-sound aria-pressed="false">Sound off</button>
    </div>

    <div class="plots" data-plots></div>

    <aside class="drawer" id="landing-params" data-drawer hidden>
      <div class="drawer-head">
        <span class="title">Parameters</span>
        <button type="button" data-reset>Reset</button>
        <button type="button" data-drawer-close aria-label="Close">✕</button>
      </div>
      <div class="params" data-params></div>
    </aside>
  </main>

  <div class="landing-about mono">
    <p>
      The ship's last 17 s of belly flop, the flip and the landing burn into the chopsticks, as the hero scene plays
      it. Change a parameter and the run is flown again; the hero scene uses the defaults. Rings on the speed plot
      are webcast readouts from Flights 13–14.
    </p>
    <p>
      Model: a rigid hull that moves in three dimensions and turns in pitch and bank, under gravity, drag split along
      and across it, and three sea-level Raptors that relight 0.35 s apart and gimbal ±15° at up to 20°/s. Guidance
      asks for an acceleration: vertically from a sink-rate schedule, horizontally from two capped loops toward the
      slot. The hull leans to point the thrust, throttle sets its size, and an engine shuts down when the throttle
      nears its floor. The flaps share the pitch moment in proportion to dynamic pressure; their drawn fold follows
      the hero scene's choreography. Reaction-control thrusters are left out.
    </p>
  </div>
</Base>

<script>
  import * as THREE from 'three';
  import { DESCENT_DEFAULTS, DESCENT_RATE, sampleAt, simulateDescent, type Descent, type DescentParams } from '../../scripts/hero3d/descent';
  import { armsOpen, carriageSag, CATCH_BASE_Y, orientShip, shipControls } from '../../scripts/hero3d/landing';
  import { buildMount, buildStack, buildTower, catchPose, R, SHIP_H, shipRig, TOWER_H, TOWER_OFFSET, TOWER_W } from '../../scripts/hero3d/starship';
  import { schematicFill, schematicInPlace } from '../../scripts/wireframes';
  import { createLaunchAudio } from '../../scripts/hero3d/audio';

  const CG_FRAC = 0.35;
  const cg = SHIP_H * CG_FRAC;
  const BASE: Partial<DescentParams> = { catchAlt: CATCH_BASE_Y + cg, length: SHIP_H, cgFrac: CG_FRAC };
  const deg = (r: number) => (r * 180) / Math.PI;
  const css = getComputedStyle(document.documentElement);
  const v = (n: string) => css.getPropertyValue(n).trim();
  const C = { text: v('--text'), muted: v('--muted'), line: v('--line'), steel: v('--steel'), sunset: v('--sunset'), sand: v('--sand'), go: v('--go') };
  const FONT = `10px ${v('--mono')}`;
  const q = <T extends HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;

  // Parameters, in a drawer.
  type Knob = { key: keyof DescentParams; label: string; min: number; max: number; step: number; scale?: number; unit: string };
  const KNOBS: Knob[] = [
    { key: 'mass', label: 'Mass at burn', min: 150e3, max: 320e3, step: 5e3, scale: 1e-3, unit: 't' },
    { key: 'thrust', label: 'Raptor thrust', min: 1.8e6, max: 3.2e6, step: 0.05e6, scale: 1e-6, unit: 'MN' },
    { key: 'minThrottle', label: 'Throttle floor', min: 0.2, max: 0.6, step: 0.01, scale: 100, unit: '%' },
    { key: 'cdaBelly', label: 'Belly drag area', min: 150, max: 550, step: 10, unit: 'm²' },
    { key: 'burnAlt', label: 'Relight altitude', min: 600, max: 1800, step: 10, unit: 'm' },
    { key: 'startVz', label: 'Southward speed', min: 0, max: 70, step: 1, unit: 'm/s' },
    { key: 'startVx', label: 'Eastward speed', min: -30, max: 40, step: 1, unit: 'm/s' },
    { key: 'burnZ', label: 'Burn point south', min: -220, max: 0, step: 5, unit: 'm' },
    { key: 'burnX', label: 'Burn point east', min: -120, max: 120, step: 5, unit: 'm' },
    { key: 'brakeDecel', label: 'Braking', min: 5, max: 16, step: 0.5, unit: 'm/s²' },
    { key: 'glideDecel', label: 'Glide braking', min: 1, max: 6, step: 0.25, unit: 'm/s²' },
    { key: 'glideH', label: 'Glide from', min: 40, max: 260, step: 5, unit: 'm' },
    { key: 'contactV', label: 'Closing speed', min: 1, max: 6, step: 0.25, unit: 'm/s' },
  ];
  const params: DescentParams = { ...DESCENT_DEFAULTS, ...BASE };
  const paramsEl = q('[data-params]');
  const knobs = KNOBS.map((k) => {
    const label = document.createElement('label');
    label.innerHTML = `<span>${k.label}</span><b></b><input type="range" min="${k.min}" max="${k.max}" step="${k.step}" />`;
    paramsEl.append(label);
    const input = q<HTMLInputElement>('input', label);
    const out = q('b', label);
    const show = () => {
      const s = k.scale ?? 1;
      out.textContent = `${Number((params[k.key] * s).toFixed(k.step * s < 1 ? 2 : 0))} ${k.unit}`;
    };
    input.value = String(params[k.key]);
    show();
    input.addEventListener('input', () => {
      params[k.key] = Number(input.value);
      show();
      rerun();
    });
    return { k, input, show };
  });
  q('[data-reset]').addEventListener('click', () => {
    Object.assign(params, DESCENT_DEFAULTS, BASE);
    knobs.forEach(({ k, input, show }) => {
      input.value = String(params[k.key]);
      show();
    });
    rerun();
  });
  const drawer = q('[data-drawer]');
  const opener = q<HTMLButtonElement>('[data-drawer-open]');
  const setDrawer = (open: boolean) => {
    drawer.hidden = !open;
    opener.setAttribute('aria-expanded', String(open));
  };
  opener.addEventListener('click', () => setDrawer(drawer.hidden));
  q('[data-drawer-close]').addEventListener('click', () => setDrawer(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && setDrawer(false));

  // Plots: strip charts over the whole run, drawn once per run and blitted under a time cursor.
  type Series = { label: string; color: string; get: (d: Descent, i: number) => number; dash?: number[] };
  type Plot = { title: string; unit: string; series: Series[]; range?: [number, number]; marks?: number[]; refs?: [number, number][] };
  const lit = (d: Descent, i: number) => d.engine[0][i] + d.engine[1][i] + d.engine[2][i];
  const PLOTS: Plot[] = [
    { title: 'Altitude', unit: 'm', series: [{ label: 'mass centre', color: C.text, get: (d, i) => d.y[i] }], marks: [0] },
    {
      title: 'Speed',
      unit: 'm/s',
      series: [{ label: '|v|', color: C.text, get: (d, i) => Math.hypot(d.vx[i], d.vy[i], d.vz[i]) }],
      refs: [
        [0, 100],
        [11, 30],
        [18, 5],
      ],
    },
    { title: 'Acceleration', unit: 'g', series: [{ label: 'along velocity', color: C.text, get: (d, i) => d.accel[i] }], marks: [0] },
    {
      title: 'Throttle',
      unit: '%',
      range: [0, 105],
      series: [
        { label: 'throttle', color: C.sunset, get: (d, i) => d.throttle[i] * 100 },
        { label: 'engines lit ×33', color: C.steel, get: (d, i) => lit(d, i) * 33.3, dash: [3, 3] },
      ],
    },
    {
      title: 'Attitude',
      unit: '°',
      series: [
        { label: 'pitch, + nose north', color: C.text, get: (d, i) => deg(d.pitch[i]) },
        { label: 'bank, + nose west', color: C.sand, get: (d, i) => deg(d.bank[i]) },
      ],
      marks: [0],
    },
    {
      title: 'Gimbal',
      unit: '°',
      range: [-16.5, 16.5],
      series: [
        { label: 'pitch plane', color: C.sunset, get: (d, i) => deg(d.gimbal[i]) },
        { label: 'east–west', color: C.sand, get: (d, i) => deg(d.gimbalBank[i]) },
      ],
      marks: [0, 15, -15],
    },
    {
      title: 'Offset from slot',
      unit: 'm',
      series: [
        { label: 'south', color: C.text, get: (d, i) => d.z[i] },
        { label: 'east', color: C.sand, get: (d, i) => d.x[i] },
      ],
      marks: [0],
    },
    {
      title: 'Flaps',
      unit: '',
      range: [-1.05, 1.05],
      series: [
        { label: 'pitch command', color: C.text, get: (d, i) => d.flap[i] },
        { label: 'dyn. pressure /8 kPa', color: C.steel, get: (d, i) => d.q[i] / 8000, dash: [3, 3] },
      ],
      marks: [0],
    },
  ];
  const plots = PLOTS.map((p) => {
    const fig = document.createElement('figure');
    const legend = p.series.map((s) => `<em style="--c:${s.color}">${s.label}</em>`).join('');
    fig.innerHTML = `<figcaption><span>${p.title}${p.unit ? ` · ${p.unit}` : ''}</span>${legend}</figcaption><div class="cv"><canvas></canvas></div>`;
    q('[data-plots]').append(fig);
    return { p, canvas: q<HTMLCanvasElement>('canvas', fig), cache: document.createElement('canvas'), map: (_b: number) => 0 };
  });

  const views = {
    side: q<HTMLCanvasElement>('[data-view="side"]'),
    close: q<HTMLCanvasElement>('[data-view="close"]'),
    top: q<HTMLCanvasElement>('[data-view="top"]'),
  };

  let sim: Descent = simulateDescent(params);
  let tEnd = 0;

  function fit(c: HTMLCanvasElement) {
    const dpr = Math.min(2, devicePixelRatio || 1);
    const w = Math.max(1, c.clientWidth), h = Math.max(1, c.clientHeight);
    if (c.width !== Math.round(w * dpr) || c.height !== Math.round(h * dpr)) {
      c.width = Math.round(w * dpr);
      c.height = Math.round(h * dpr);
    }
    const ctx = c.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { ctx, w, h, dpr };
  }

  const PAD = { l: 32, r: 6, t: 4, b: 14 };
  function drawPlots() {
    const a = sim.t0, z = tEnd;
    for (const pl of plots) {
      const { canvas, cache, p } = pl;
      const { w, h, dpr } = fit(canvas);
      cache.width = canvas.width;
      cache.height = canvas.height;
      const ctx = cache.getContext('2d')!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      let [lo, hi] = p.range ?? [Infinity, -Infinity];
      if (!p.range) {
        for (const s of p.series)
          for (let i = 0; i < sim.n; i++) {
            const x = s.get(sim, i);
            lo = Math.min(lo, x);
            hi = Math.max(hi, x);
          }
        for (const [, x] of p.refs ?? []) hi = Math.max(hi, x);
        for (const m of p.marks ?? []) (lo = Math.min(lo, m)), (hi = Math.max(hi, m));
        const pad = (hi - lo) * 0.08 || 1;
        lo -= pad;
        hi += pad;
      }
      const X = (b: number) => PAD.l + ((b - a) / (z - a)) * (w - PAD.l - PAD.r);
      const Y = (x: number) => PAD.t + (1 - (x - lo) / (hi - lo)) * (h - PAD.t - PAD.b);
      pl.map = X;
      ctx.font = FONT;
      ctx.lineWidth = 1;
      ctx.strokeStyle = C.line;
      ctx.fillStyle = C.muted;
      ctx.textAlign = 'center';
      for (let b = Math.ceil(a / 5) * 5; b <= z; b += 5) {
        ctx.beginPath();
        ctx.moveTo(X(b), PAD.t);
        ctx.lineTo(X(b), h - PAD.b);
        ctx.stroke();
        ctx.fillText(String(b), X(b), h - 3);
      }
      ctx.textAlign = 'right';
      for (const x of [...(p.range ? [] : [lo + (hi - lo) * 0.08, hi - (hi - lo) * 0.08]), ...(p.marks ?? [])]) {
        const isMark = p.marks?.includes(x);
        ctx.strokeStyle = isMark ? C.muted : C.line;
        ctx.setLineDash(isMark && x !== 0 ? [2, 3] : []);
        ctx.beginPath();
        ctx.moveTo(PAD.l, Y(x));
        ctx.lineTo(w - PAD.r, Y(x));
        ctx.stroke();
        ctx.fillText(Math.abs(x) >= 100 ? x.toFixed(0) : Number(x.toFixed(1)).toString(), PAD.l - 4, Y(x) + 3);
      }
      for (const s of p.series) {
        ctx.strokeStyle = s.color;
        ctx.lineWidth = 1.5;
        ctx.setLineDash(s.dash ?? []);
        ctx.beginPath();
        for (let i = 0; i < sim.n; i++) {
          const x = X(sim.t0 + i / DESCENT_RATE), y = Y(s.get(sim, i));
          if (i) ctx.lineTo(x, y);
          else ctx.moveTo(x, y);
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.strokeStyle = C.go;
      for (const [b, x] of p.refs ?? []) {
        ctx.beginPath();
        ctx.arc(X(b), Y(x), 3.5, 0, Math.PI * 2);
        ctx.stroke();
      }
    }
  }

  function drawCursors(b: number) {
    for (const { canvas, cache, map } of plots) {
      const { ctx, w, h } = fit(canvas);
      ctx.clearRect(0, 0, w, h);
      ctx.drawImage(cache, 0, 0, w, h);
      ctx.strokeStyle = C.sunset;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(map(b), PAD.t);
      ctx.lineTo(map(b), h - PAD.b);
      ctx.stroke();
    }
  }

  const state = (b: number) => {
    const s = (ch: Float32Array) => sampleAt(sim, ch, b);
    return {
      x: s(sim.x), y: s(sim.y), z: s(sim.z),
      v: Math.hypot(s(sim.vx), s(sim.vy), s(sim.vz)),
      pitch: s(sim.pitch), bank: s(sim.bank), gimbal: s(sim.gimbal), gimbalBank: s(sim.gimbalBank),
      engines: [s(sim.engine[0]), s(sim.engine[1]), s(sim.engine[2])] as [number, number, number],
      throttle: s(sim.throttle), accel: s(sim.accel),
    };
  };
  type State = ReturnType<typeof state>;
  type Map2 = (a: number, b: number) => [number, number];

  // The ship, mount and tower as hidden-line schematics, like the Vehicles cards, in world coordinates. Each view
  // renders them orthographically into exactly the pixels it draws. From the side they share one pass, so the
  // near chopstick passes in front of the ship, and the 2D flame goes on top; from above the ship hides its own
  // flame, so it is tower, flame, ship, and the mount is left out so it doesn't cover the grid. Flaps, engines and chopsticks move as in the hero scene.
  const gl = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
  gl.setClearColor(0x000000, 0);
  const GL_PX = 2048;
  gl.setSize(GL_PX, GL_PX, false);
  const scene = new THREE.Scene();
  const LAYER = { mount: 1, tower: 2, ship: 3 };
  // Light steel and a mid-grey heat shield, so the ship reads against the black views. The tower is a lighter
  // grey and the mount nearly black, so the tower and its arms stand out against the mount from above.
  const steelFill = schematicFill(new THREE.Color(0xa9acb2), new THREE.Color(0xf2f2f2));
  const tileFill = schematicFill(new THREE.Color(0x3a3b40), new THREE.Color(0x8d8d93));
  const towerFill = schematicFill(new THREE.Color(0x8a8d93), new THREE.Color(0xe4e6ea));
  const mountFill = schematicFill(new THREE.Color(0x1e1f22), new THREE.Color(0x4a4c51));
  const creaseMat = new THREE.LineBasicMaterial({ color: 0x1a1a1c, transparent: true, opacity: 0.55 });
  const creases: Record<keyof typeof LAYER, THREE.LineSegments[]> = { mount: [], tower: [], ship: [] };
  function prepare(root: THREE.Object3D, layer: keyof typeof LAYER, fill: (m: THREE.Material) => THREE.Material) {
    schematicInPlace(root, 24, fill);
    root.traverse((o) => {
      o.layers.set(LAYER[layer]);
      if ((o as THREE.LineSegments).isLineSegments) {
        (o as THREE.LineSegments).material = creaseMat;
        creases[layer].push(o as THREE.LineSegments);
      }
    });
  }

  const pivot = new THREE.Group();
  scene.add(pivot);
  const ship = buildStack(null).getObjectByName('ship')!;
  ship.removeFromParent();
  ship.position.set(0, -cg, 0);
  pivot.add(ship);
  prepare(pivot, 'ship', (m) => (m.name === 'tiles' ? tileFill : steelFill));
  const rig = shipRig(ship);

  const mount = buildMount(null);
  prepare(mount, 'mount', () => mountFill);
  scene.add(mount);
  const tower = buildTower(null);
  tower.group.position.set(0, 0, TOWER_OFFSET);
  tower.group.rotation.y = Math.PI / 2;
  prepare(tower.group, 'tower', () => towerFill);
  scene.add(tower.group);

  const cams = { side: new THREE.OrthographicCamera(), top: new THREE.OrthographicCamera() };
  cams.top.up.set(0, 0, -1);
  const pose = {
    quaternion: pivot.quaternion,
    engines: [0, 0, 0] as [number, number, number],
    aftFlaps: [0, 0] as [number, number],
    fwdFlaps: [0, 0] as [number, number],
    gimbal: [[0, 0], [0, 0], [0, 0]] as [number, number][],
  };
  /** Below this many pixels per metre the crease lines are finer than a pixel and only flicker. */
  const CREASES_FROM = { ship: 3, mount: 4, tower: 4 };
  function poseScene(b: number, st: State) {
    pivot.position.set(st.x, st.y, st.z);
    orientShip(sim, b, pivot.quaternion);
    pose.engines = st.engines;
    shipControls(sim, b, pose);
    rig.setFlaps(pose.aftFlaps, pose.fwdFlaps);
    pose.gimbal.forEach((g, i) => rig.setGimbal(i, g[0], g[1]));
    tower.setPose(catchPose(CATCH_BASE_Y - carriageSag(sim, b), armsOpen(sim, b)));
  }

  /**
   * Renders one layer looking west from the beach (`side`) or down (`top`), `px` pixels per metre, with world
   * point `centre` at the middle of the destination rectangle (x, y, w, h). Rendered at the exact pixel size it
   * is drawn at, so the GPU's antialiasing does the smoothing rather than a downscale that drops thin parts in
   * and out from frame to frame.
   */
  function render(
    ctx: CanvasRenderingContext2D,
    view: 'side' | 'top',
    layers: (keyof typeof LAYER)[],
    centre: THREE.Vector3,
    px: number,
    rect: [number, number, number, number],
  ) {
    const [x, y, w, h] = rect;
    const dpr = Math.min(2, devicePixelRatio || 1, GL_PX / Math.max(w, h));
    const nw = Math.max(2, Math.round(w * dpr)), nh = Math.max(2, Math.round(h * dpr));
    const cam = cams[view];
    cam.left = -w / (2 * px);
    cam.right = w / (2 * px);
    cam.top = h / (2 * px);
    cam.bottom = -h / (2 * px);
    cam.near = 1;
    cam.far = 6000;
    if (view === 'side') cam.position.set(centre.x + 3000, centre.y, centre.z);
    else cam.position.set(centre.x, centre.y + 3000, centre.z);
    cam.lookAt(centre);
    cam.updateProjectionMatrix();
    cam.layers.disableAll();
    for (const l of layers) {
      cam.layers.enable(LAYER[l]);
      for (const c of creases[l]) c.visible = px >= CREASES_FROM[l];
    }
    gl.setViewport(0, 0, nw, nh);
    gl.render(scene, cam);
    ctx.drawImage(gl.domElement, 0, GL_PX - nh, nw, nh, x, y, w, h);
  }

  /**
   * One jet for the three engines, which overlap: steady length, slightly thinner throttled. It leaves the base
   * opposite the thrust, which the gimbal swings off the hull axis in the pitch plane. `project` takes world
   * (x, y, z) to the screen; `px` is pixels per metre.
   */
  function drawFlame(ctx: CanvasRenderingContext2D, st: State, project: (x: number, y: number, z: number) => [number, number], px: number) {
    const on = st.engines[0] + st.engines[1] + st.engines[2];
    if (on < 0.01) return;
    const sp = Math.sin(st.pitch), cp = Math.cos(st.pitch), sb = Math.sin(st.bank), cb = Math.cos(st.bank);
    const tp = st.pitch - st.gimbal;
    const len = 46 * Math.min(1, on) * (0.93 + 0.07 * st.throttle);
    const half = R * (0.3 + 0.15 * Math.min(1, on / 3)) * (0.84 + 0.16 * st.throttle) * px;
    const base = [st.x + sb * cp * cg, st.y - cb * cp * cg, st.z + sp * cg];
    const tip = [base[0] + sb * Math.cos(tp) * len, base[1] - cb * Math.cos(tp) * len, base[2] + Math.sin(tp) * len];
    const [x0, y0] = project(base[0], base[1], base[2]);
    const [x1, y1] = project(tip[0], tip[1], tip[2]);
    const d = Math.hypot(x1 - x0, y1 - y0);
    if (d < half) return;
    const nx = (-(y1 - y0) / d) * half, ny = ((x1 - x0) / d) * half;
    const g = ctx.createLinearGradient(x0, y0, x1, y1);
    g.addColorStop(0, 'rgba(255,255,255,0.95)');
    g.addColorStop(0.35, 'rgba(255,190,200,0.7)');
    g.addColorStop(1, 'rgba(255,140,170,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.moveTo(x0 + nx, y0 + ny);
    ctx.lineTo(x1, y1);
    ctx.lineTo(x0 - nx, y0 - ny);
    ctx.fill();
  }

  /** The tower and mount in outline, for the wide side view where the model would be a few pixels. */
  function drawTower(ctx: CanvasRenderingContext2D, map: Map2, lw = 1) {
    ctx.strokeStyle = C.muted;
    ctx.lineWidth = lw;
    const half = (TOWER_W / 2) * Math.SQRT2;
    ctx.beginPath();
    for (const dz of [-half, half]) {
      ctx.moveTo(...map(TOWER_OFFSET + dz, 0));
      ctx.lineTo(...map(TOWER_OFFSET + dz, TOWER_H));
    }
    ctx.moveTo(...map(TOWER_OFFSET - half, TOWER_H));
    ctx.lineTo(...map(TOWER_OFFSET + half, TOWER_H));
    ctx.stroke();
    ctx.beginPath();
    for (const [z, y] of [[-10, 0], [-10, 20], [10, 20], [10, 0]]) ctx.lineTo(...map(z, y));
    ctx.stroke();
  }

  const TRAIL_W = 1.5;
  /** The track flown so far, `lw` pixels wide: orange under thrust. */
  function trail(ctx: CanvasRenderingContext2D, b: number, map: (i: number) => [number, number], lw = TRAIL_W) {
    ctx.lineWidth = lw;
    ctx.lineCap = 'round';
    for (let i = 1; i < sim.n && sim.t0 + i / DESCENT_RATE <= b; i++) {
      ctx.strokeStyle = sim.throttle[i] > 0 ? C.sunset : C.muted;
      ctx.beginPath();
      ctx.moveTo(...map(i - 1));
      ctx.lineTo(...map(i));
      ctx.stroke();
    }
    ctx.lineCap = 'butt';
  }

  const NICE = [1, 2, 5, 10, 20, 50, 100, 200];
  const nice = (x: number) => NICE.reduce((a, n) => (Math.abs(Math.log(n / x)) < Math.abs(Math.log(a / x)) ? n : a));
  /**
   * A loupe on the wide views: a circle on the ship showing it magnified, with its flame, recent track and a fine
   * grid fixed to the ground. `ship` is its world position (a, b), drawn at screen point `at`; `sign` gives the
   * screen direction of +a and +b. Both loupes magnify to `loupePx` pixels per metre, which the side view
   * sets, so the ship is the same size in each. `content` draws with the magnified map and scale (px per metre).
   */
  let loupePx = 1;
  function loupe(
    ctx: CanvasRenderingContext2D,
    w: number,
    h: number,
    at: [number, number],
    ship: [number, number],
    sign: [number, number],
    s: number,
    sets: boolean,
    content: (m: Map2, px: number, rect: [number, number, number, number]) => void,
  ) {
    const r = Math.max(40, Math.min(w, h) * 0.17);
    if (sets) loupePx = s * nice((0.8 * r) / (SHIP_H * s));
    const k = loupePx / s;
    // Centred on the ship when it fits; near an edge it moves inward, with a leader to the ship's true spot.
    const cx = Math.min(w - r - 2, Math.max(r + 2, at[0]));
    const cy = Math.min(h - r - 18, Math.max(r + 2, at[1]));
    const m: Map2 = (a, b) => [cx + sign[0] * (a - ship[0]) * s * k, cy + sign[1] * (b - ship[1]) * s * k];
    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.clip();
    ctx.fillStyle = '#000';
    ctx.fillRect(cx - r, cy - r, 2 * r, 2 * r);
    const cell = nice(40 / (s * k));
    const R = r / (s * k) + cell;
    ctx.strokeStyle = C.line;
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let g = Math.floor((ship[0] - R) / cell) * cell; g <= ship[0] + R; g += cell) {
      ctx.moveTo(...m(g, ship[1] - R));
      ctx.lineTo(...m(g, ship[1] + R));
    }
    for (let g = Math.floor((ship[1] - R) / cell) * cell; g <= ship[1] + R; g += cell) {
      ctx.moveTo(...m(ship[0] - R, g));
      ctx.lineTo(...m(ship[0] + R, g));
    }
    ctx.stroke();
    content(m, s * k, [cx - r, cy - r, 2 * r, 2 * r]);
    ctx.restore();
    ctx.strokeStyle = C.sunset;
    ctx.fillStyle = C.sunset;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    const off = Math.hypot(at[0] - cx, at[1] - cy);
    if (off > r) {
      ctx.moveTo(cx + ((at[0] - cx) / off) * r, cy + ((at[1] - cy) / off) * r);
      ctx.lineTo(...at);
    }
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(at[0], at[1], 2, 0, Math.PI * 2);
    if (off > r) ctx.fill();
    const label = `×${+k.toFixed(k < 10 ? 1 : 0)} · ${cell} m grid`;
    ctx.font = FONT;
    ctx.textAlign = 'center';
    const tw = ctx.measureText(label).width;
    const ly = cy + r + 12;
    ctx.fillStyle = '#000';
    ctx.fillRect(cx - tw / 2 - 3, ly - 9, tw + 6, 12);
    ctx.fillStyle = C.sunset;
    ctx.fillText(label, cx, ly);
  }

  function drawSide(b: number, st: State) {
    const { ctx, w, h } = fit(views.side);
    ctx.clearRect(0, 0, w, h);
    let zMin = -40, zMax = TOWER_OFFSET + 10, yMax = 200;
    for (let i = 0; i < sim.n; i++) {
      zMin = Math.min(zMin, sim.z[i]);
      zMax = Math.max(zMax, sim.z[i]);
      yMax = Math.max(yMax, sim.y[i]);
    }
    const s = Math.min((w - 40) / (zMax - zMin + 40), (h - 40) / (yMax * 1.04));
    const zMid = (zMin + zMax) / 2;
    const map: Map2 = (z, y) => [w / 2 - (z - zMid) * s, h - 14 - y * s];
    ctx.strokeStyle = C.line;
    ctx.fillStyle = C.muted;
    ctx.font = FONT;
    ctx.textAlign = 'left';
    ctx.lineWidth = 1;
    // A square grid.
    const cell = 500;
    ctx.beginPath();
    for (let y = cell; y <= yMax + cell; y += cell) {
      const [, sy] = map(0, y);
      ctx.moveTo(0, sy);
      ctx.lineTo(w, sy);
      ctx.fillText(`${y} m`, 4, sy - 3);
    }
    const zSpan = w / s / 2 + cell;
    for (let z = Math.floor((zMid - zSpan) / cell) * cell; z <= zMid + zSpan; z += cell) {
      const [sx] = map(z, 0);
      ctx.moveTo(sx, 0);
      ctx.lineTo(sx, map(0, 0)[1]);
    }
    ctx.stroke();
    drawTower(ctx, map);
    ctx.textAlign = 'center';
    ctx.fillText('S', 8, h - 3);
    ctx.fillText('N', w - 8, h - 3);
    trail(ctx, b, (i) => map(sim.z[i], sim.y[i]));
    const [cx, cy] = map(st.z, st.y);
    // Looking west, north (−z) is to the right.
    loupe(ctx, w, h, [cx, cy], [st.z, st.y], [-1, -1], s, true, (m, px, rect) => {
      const at = new THREE.Vector3(st.x, st.y, st.z);
      trail(ctx, b, (i) => m(sim.z[i], sim.y[i]), (TRAIL_W * px) / s);
      render(ctx, 'side', ['mount', 'tower', 'ship'], at, px, rect);
      drawFlame(ctx, st, (_x, y, z) => m(z, y), px);
    });
  }

  const GRID = 20;
  function drawClose(b: number, st: State) {
    const { ctx, w, h } = fit(views.close);
    ctx.clearRect(0, 0, w, h);
    const s = Math.min(w, h) / 110;
    const cz = st.z, cy = Math.max(st.y, h / s / 2 - 8);
    const map: Map2 = (z, y) => [w / 2 - (z - cz) * s, h / 2 - (y - cy) * s];
    // A 20 m grid fixed to the ground, both ways, so its motion shows the ship's.
    ctx.strokeStyle = C.line;
    ctx.lineWidth = 1;
    ctx.fillStyle = C.muted;
    ctx.font = FONT;
    ctx.textAlign = 'left';
    const zSpan = w / s / 2 + GRID, ySpan = h / s / 2 + GRID;
    ctx.beginPath();
    for (let z = Math.floor((cz - zSpan) / GRID) * GRID; z <= cz + zSpan; z += GRID) {
      const [sx] = map(z, 0);
      ctx.moveTo(sx, 0);
      ctx.lineTo(sx, Math.min(h, map(0, 0)[1]));
    }
    for (let y = Math.max(GRID, Math.floor((cy - ySpan) / GRID) * GRID); y <= cy + ySpan; y += GRID) {
      const [, sy] = map(0, y);
      ctx.moveTo(0, sy);
      ctx.lineTo(w, sy);
    }
    ctx.stroke();
    for (let y = Math.max(GRID, Math.floor((cy - ySpan) / GRID) * GRID); y <= cy + ySpan; y += GRID) {
      if (y % (GRID * 2) === 0) ctx.fillText(`${y}`, 4, map(0, y)[1] - 3);
    }
    const [, gy] = map(0, 0);
    if (gy < h) {
      ctx.fillStyle = '#101012';
      ctx.fillRect(0, gy, w, h - gy);
    }
    const at = new THREE.Vector3(st.x, cy, cz);
    render(ctx, 'side', ['mount', 'tower', 'ship'], at, s, [0, 0, w, h]);
    drawFlame(ctx, st, (_x, y, z) => map(z, y), s);

    // Engine map: the three sea-level engines from below, lit by spool, each dot pushed by its gimbal.
    const ex = 40, ey = h - 46, ring = 28;
    ctx.strokeStyle = C.muted;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(ex, ey, ring, 0, Math.PI * 2);
    ctx.stroke();
    const k = 8 / ((15 * Math.PI) / 180);
    st.engines.forEach((e, i) => {
      const a = -Math.PI / 2 + (i * 2 * Math.PI) / 3;
      const px = ex + Math.cos(a) * 12, py = ey + Math.sin(a) * 12;
      ctx.strokeStyle = C.muted;
      ctx.beginPath();
      ctx.arc(px, py, 8.5, 0, Math.PI * 2);
      ctx.stroke();
      if (e > 0.01) {
        ctx.fillStyle = `rgba(255,255,255,${0.2 + 0.8 * e})`;
        ctx.beginPath();
        ctx.arc(px + st.gimbalBank * k, py + st.gimbal * k, 3.5, 0, Math.PI * 2);
        ctx.fill();
      }
    });
  }

  function drawTop(b: number, st: State) {
    const { ctx, w, h } = fit(views.top);
    ctx.clearRect(0, 0, w, h);
    let x0 = -40, x1 = 40, z0 = -40, z1 = TOWER_OFFSET + 15;
    for (let i = 0; i < sim.n; i++) {
      x0 = Math.min(x0, sim.x[i]);
      x1 = Math.max(x1, sim.x[i]);
      z0 = Math.min(z0, sim.z[i]);
      z1 = Math.max(z1, sim.z[i]);
    }
    const s = Math.min((w - 40) / (x1 - x0), (h - 40) / (z1 - z0));
    const xm = (x0 + x1) / 2, zm = (z0 + z1) / 2;
    const map: Map2 = (x, z) => [w / 2 + (x - xm) * s, h / 2 + (z - zm) * s];
    const grid = 100;
    ctx.strokeStyle = C.line;
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let g = Math.floor(Math.min(x0, z0) / grid) * grid - grid * 4; g <= Math.max(x1, z1) + grid * 4; g += grid) {
      ctx.moveTo(map(g, 0)[0], 0);
      ctx.lineTo(map(g, 0)[0], h);
      ctx.moveTo(0, map(0, g)[1]);
      ctx.lineTo(w, map(0, g)[1]);
    }
    ctx.stroke();
    ctx.strokeStyle = C.muted;
    ctx.beginPath();
    ctx.arc(...map(0, 0), Math.max(2, R * s), 0, Math.PI * 2);
    ctx.stroke();
    const [tx, tz] = map(0, TOWER_OFFSET);
    const half = Math.max(3, (TOWER_W / 2) * Math.SQRT2 * s);
    ctx.beginPath();
    ctx.moveTo(tx, tz - half);
    ctx.lineTo(tx + half, tz);
    ctx.lineTo(tx, tz + half);
    ctx.lineTo(tx - half, tz);
    ctx.closePath();
    ctx.stroke();
    ctx.fillStyle = C.muted;
    ctx.font = FONT;
    ctx.textAlign = 'center';
    ctx.fillText('N', w / 2, 12);
    trail(ctx, b, (i) => map(sim.x[i], sim.z[i]));
    const [px, pz] = map(st.x, st.z);
    loupe(ctx, w, h, [px, pz], [st.x, st.z], [1, 1], s, false, (m, k, rect) => {
      const at = new THREE.Vector3(st.x, st.y, st.z);
      render(ctx, 'top', ['tower'], at, k, rect);
      trail(ctx, b, (i) => m(sim.x[i], sim.z[i]), (TRAIL_W * k) / s);
      drawFlame(ctx, st, (x, _y, z) => m(x, z), k);
      render(ctx, 'top', ['ship'], at, k, rect);
    });
  }

  const R_ = (k: string) => q(`[data-r="${k}"]`);
  function readouts(b: number, st: State) {
    R_('t').textContent = `${b >= 0 ? '+' : '−'}${Math.abs(b).toFixed(1)} s`;
    R_('alt').textContent = `${st.y.toFixed(0)} m`;
    R_('v').textContent = `${st.v.toFixed(1)} m/s`;
    R_('g').textContent = `${(Math.abs(st.accel) < 0.005 ? 0 : st.accel).toFixed(2)} g`;
    R_('thr').textContent = st.throttle > 0 ? `${(st.throttle * 100).toFixed(0)}% × ${st.engines.filter((e) => e > 0.5).length}` : '—';
    R_('pitch').textContent = `${deg(st.pitch).toFixed(1)}°`;
    R_('gim').textContent = st.engines.some((e) => e > 0.01) ? `${deg(st.gimbal).toFixed(1)}° / ${deg(st.gimbalBank).toFixed(1)}°` : '—';
  }

  function summary() {
    const S = (k: string) => q(`[data-s="${k}"]`);
    const [side, down] = sim.contactSpeed;
    const soft = sim.landed && down < 5 && side < 1;
    const verdict = S('verdict');
    verdict.textContent = !sim.landed ? 'Missed' : soft ? 'Caught' : 'Hard';
    verdict.style.color = soft ? C.go : C.sunset;
    S('contact').textContent = sim.contact.toFixed(1);
    S('speed').textContent = `${down.toFixed(1)} / ${side.toFixed(1)}`;
    S('cuts').textContent = sim.shutdowns.length ? sim.shutdowns.map((t) => t.toFixed(1)).join(' · ') : 'none';
    let gm = 0;
    for (let i = 0; i < sim.n; i++) gm = Math.max(gm, Math.abs(sim.gimbal[i]), Math.abs(sim.gimbalBank[i]));
    S('gim').textContent = deg(gm).toFixed(0);
    S('stops').textContent = sim.saturated.gimbal.toFixed(1);
    S('prop').textContent = ((sim.mass[0] - sim.mass[sim.n - 1]) / 1000).toFixed(1);
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scrub = q<HTMLInputElement>('[data-scrub]');
  const playBtn = q<HTMLButtonElement>('[data-play]');
  const rateBtn = q<HTMLButtonElement>('[data-rate]');
  let playing = !reduced;
  let rate = 1;
  let b = reduced ? 0 : sim.t0;
  let last = performance.now();
  playBtn.textContent = playing ? 'Pause' : 'Play';

  function rerun() {
    sim = simulateDescent(params);
    tEnd = sim.t0 + (sim.n - 1) / DESCENT_RATE;
    b = Math.min(b, tEnd);
    drawPlots();
    summary();
    draw();
  }
  function draw() {
    const st = state(b);
    poseScene(b, st);
    drawSide(b, st);
    drawClose(b, st);
    drawTop(b, st);
    drawCursors(b);
    readouts(b, st);
    scrub.value = String((b - sim.t0) / (tEnd - sim.t0));
  }

  playBtn.addEventListener('click', () => {
    playing = !playing;
    if (playing && b >= tEnd) b = sim.t0;
    playBtn.textContent = playing ? 'Pause' : 'Play';
  });
  rateBtn.addEventListener('click', () => {
    rate = rate === 1 ? 0.25 : 1;
    rateBtn.textContent = rate === 1 ? '1×' : '¼×';
  });
  scrub.addEventListener('input', () => {
    b = sim.t0 + Number(scrub.value) * (tEnd - sim.t0);
    playing = false;
    playBtn.textContent = 'Play';
    draw();
  });
  new ResizeObserver(() => {
    drawPlots();
    draw();
  }).observe(q('.landing-lab'));

  // Sound: the hero scene's synthesized engines, as heard on its beach. What arrives now left the ship one
  // sound-travel time earlier; loudness and brightness fall with distance. Only at 1× while playing.
  const EAR = new THREE.Vector3(480, 2.4, -60);
  const SOUND_SPEED = 343;
  const audio = createLaunchAudio({ tracks: [], music: false });
  const soundBtn = q<HTMLButtonElement>('[data-sound]');
  soundBtn.addEventListener('click', async () => {
    if (audio.enabled) await audio.disable();
    else await audio.enable();
    soundBtn.textContent = audio.enabled ? 'Sound on' : 'Sound off';
    soundBtn.setAttribute('aria-pressed', String(audio.enabled));
  });
  const at3 = new THREE.Vector3();
  function listen() {
    if (!audio.enabled) return;
    audio.setMuted(!playing || rate !== 1);
    let e = b;
    for (let i = 0; i < 4; i++) {
      const c = Math.max(sim.t0, e);
      e = b - at3.set(sampleAt(sim, sim.x, c), sampleAt(sim, sim.y, c), sampleAt(sim, sim.z, c)).distanceTo(EAR) / SOUND_SPEED;
    }
    const heardPower = e < sim.t0 ? 0 : (sampleAt(sim, sim.engine[0], e) + sampleAt(sim, sim.engine[1], e) + sampleAt(sim, sim.engine[2], e)) / 3;
    const ret = { b, caught: false, heardPower, heardDist: at3.distanceTo(EAR) };
    audio.update({ phase: 'flight', t: 0, alt: 0, vel: 0, ret }, EAR.length() / SOUND_SPEED);
  }

  function frame(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (playing) {
      b += dt * rate;
      if (b > tEnd + 1.5) b = sim.t0;
      draw();
    }
    listen();
    requestAnimationFrame(frame);
  }
  rerun();
  requestAnimationFrame(frame);
  (window as unknown as { __landing: unknown }).__landing = {
    seek: (t: number) => ((b = t), (playing = false), draw()),
    audio,
    params: (open: boolean) => setDrawer(open),
  };
</script>

