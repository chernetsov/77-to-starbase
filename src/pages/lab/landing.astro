  }
  .landing-lab .readouts div { display: flex; justify-content: flex-end; gap: 10px; }
  .landing-lab .readouts dt { font-size: 0.6rem; }
  .landing-lab .readouts dd { margin: 0; min-width: 9.5em; color: var(--text); letter-spacing: 0.04em; text-shadow: 0 0 1px rgba(0, 0, 0, 0.6), 0 1px 4px rgba(0, 0, 0, 0.55); }
  .landing-lab .transport { display: flex; gap: var(--gap); align-items: center; }
  .landing-lab .transport input { flex: 1; min-width: 120px; accent-color: var(--sunset); }
  .landing-lab .plots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 8px 16px; min-height: 0; }
  .landing-lab button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: 6px 12px;
    cursor: pointer;
    min-width: 64px;
  }
  .landing-lab button:hover { border-color: var(--sunset); color: var(--sunset); }
  .landing-lab .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 100vw);
    box-sizing: border-box;
    padding: 14px 18px 24px;
    background: var(--panel);
    border-left: 1px solid var(--line);
    overflow-y: auto;
    z-index: 10;
