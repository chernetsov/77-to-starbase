  .landing-lab figcaption { font-size: 0.6rem; display: flex; gap: 2px 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .landing-lab figcaption span { color: var(--steel); }
  .landing-lab figcaption em { font-style: normal; text-transform: none; letter-spacing: 0.02em; }
  .landing-lab figcaption em::before { content: ''; display: inline-block; width: 10px; height: 2px; margin: 0 5px 3px 0; background: var(--c); }
  .landing-lab .stage { display: grid; grid-template-columns: 1fr 1.6fr 1fr; gap: var(--gap); min-height: 0; }
  .landing-lab .view { grid-template-rows: minmax(0, 1fr) auto; }
