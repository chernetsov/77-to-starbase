  }
  .landing-lab .bar { display: flex; align-items: center; gap: 8px 18px; flex-wrap: wrap; }
  .landing-lab .back { color: var(--muted); text-decoration: none; letter-spacing: 0.1em; }
  .landing-lab .back:hover { color: var(--text); }
