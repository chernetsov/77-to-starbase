---
import Base from '../layouts/Base.astro';
import Hero3D from '../components/Hero3D.astro';
import TripMap from '../components/TripMap.astro';
import SignupForm from '../components/SignupForm.astro';
import Host from '../components/Host.astro';
import SiteNav from '../components/SiteNav.astro';
import GroundTrackStops from '../components/GroundTrackStops.astro';
import launches from '../data/launches.json';
import route from '../data/route.json';

const totalMi = Math.round(route.main.distanceMi);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const nextTexas = launches.upcoming.find((l) => l.texas && l.net);

const confidenceLabel: Record<string, string> = {
  medium: 'Provisional date',
  low: 'Very provisional',
  'very-low': 'Educated guess',
};
const confidenceLevel: Record<string, number> = { medium: 3, low: 2, 'very-low': 1 };

const plan = [
  {
    day: 'Day 1',
    t: 'L-2',
    title: 'Touchdown · Austin',
    where: 'AUS → South Congress',
    items: [
      'Land at AUS. I pick you up in the Cybertruck.',
      'Barbecue: Franklin if you can face the line (people queue for hours before it opens), otherwise la Barbecue or Terry Black’s.',
      'Boots and a hat at Allens Boots on South Congress, then a walk down the strip.',
      'Dusk at the Congress Avenue Bridge, where about 1.5 million bats fly out (March to October). Out of season: Rainey Street.',
    ],
  },
  {
    day: 'Day 2',
    t: 'L-1',
    title: 'The drive · Highway 77',
    where: 'Austin → Starbase → South Padre Island',
    items: [
      'Early start. Lockhart, the barbecue capital of Texas: brisket for breakfast is allowed.',
      'Luling Buc-ee’s, the largest convenience store in the world. Brisket sandwich and beaver nuggets. Stock up: the ranch country further south is long and empty.',
      'Charge in Victoria, then the long, straight run down US-77 through Kingsville and King Ranch.',
      'Brownsville at golden hour, then east on Highway 4 to Starbase. If the rocket is stacked, it is lit up on the pad after dark.',
      'Highway 4 sometimes closes at night to move vehicles, so we check before we turn off. Then about an hour around the bay to the island.',
    ],
  },
  {
    day: 'Day 3',
    t: 'L-0',
    title: 'Launch · Beach',
    where: 'Isla Blanca Park, South Padre Island',
    items: [
      'Recent windows have opened in the early morning or the early evening. The exact time firms up a few days out.',
      'Highway 4 and Boca Chica Beach close for the launch, so we watch from Isla Blanca Park, about 5 miles across the pass. Get there early: island traffic backs up.',
      'Liftoff. The sound arrives roughly 25 seconds after you see it. If they try a catch, watch the booster fly back to the tower.',
      'The rest of the day on the beach. Gulf ceviche.',
    ],
  },
  {
    day: 'Day 4',
    t: 'L+1',
    title: 'Return · US-77 north',
    where: 'South Padre Island → Austin',
    items: [
      `The same ${totalMi} miles back: 6 to 7 hours of driving, more with stops. Long conversations included.`,
      'Border Patrol checkpoint on US-77 near Sarita, northbound only. ID on you.',
      'Luling Buc-ee’s again, for everything you said you would buy on the way down.',
      'Back in Austin by evening. One last brisket.',
    ],
  },
];

const departure = {
  day: 'Day 5',
  t: 'L+2',
  title: 'Wheels up',
  text: 'Fly home from AUS on Day 5. It doesn’t count as a trip day, but don’t book Day 4: after 6+ hours on the road you would be racing for an evening flight. Launches often slip a day or more, so book a fare you can change, and if you can spare one buffer day, take it.',
};

const checklist = [
  ['ID on you', 'US-77 has a Border Patrol checkpoint on the way north. Non-citizens bring a passport or green card.'],
  ['Flexible flight', 'Book a fare you can change. Launch dates can move by days or weeks.'],
  ['Layers', 'Pre-dawn on the beach is chilly, and noon is not.'],
  ['Binoculars', 'Five miles is close, but not that close.'],
  ['Boots budget', 'You will be tempted.'],
];
---

<Base
  title="77 to Starbase · Austin to a Starship launch"
  description="A road trip from Austin to Starbase in a Cybertruck to watch a Starship launch. Barbecue, boots, Buc-ee's, beach, and a rocket."
>
  <header class="hero">
    <Hero3D />
    <SiteNav />
    <div class="wrap hero-copy" id="top">
      <p class="hud-label hero-eyebrow">A friends-only ground mission · Austin → Starbase, Texas</p>
      <h1>77 to<br />Starbase</h1>
      <p class="lede hero-lede">
        Land in Austin. Brisket for breakfast. Then {totalMi} miles south in a Cybertruck, until the road runs out at the
        Gulf and a 124-meter rocket fills the windshield.
      </p>
      <a class="host-chip" href="#host">
        <img src={`${base}images/misha-600.jpg`} width="600" height="750" alt="" decoding="async" />
        <span><b>Hosted by Misha</b> · I'll pick you up at AUS</span>
      </a>
      {nextTexas && (
        <div class="countdown" data-net={nextTexas.net}>
          <span class="hud-label">{nextTexas.name} · NET</span>
          <span class="hud-value clock" aria-live="off">T−−−<small>d</small> −−<small>h</small> −−<small>m</small></span>
        </div>
      )}
      <div class="ctas">
        <a class="btn primary" href="#crew">Request a seat</a>
        <a class="btn" href="#plan">See the flight plan</a>
      </div>
    </div>
  </header>

  <main>
    <Host n="01" />

    <section id="profile">
      <div class="wrap">
        <p class="eyebrow">02 · Ground track</p>
        <h2>One road, mostly</h2>
        <p class="lede">
          Out of Austin through barbecue country, then onto US-77 at Victoria for the long, straight run south through
          ranch land to the Mexican border. {totalMi} miles to the island, plus a {Math.round(route.recon.distanceMi)}-mile
          round trip to the pads on recon day (dashed).
        </p>
        <div class="route-grid">
          <ol class="legs mono">
            {route.stops.map((s, i) => (
              <li>
                <button type="button" class="gt-leg" data-stop={s.id} aria-controls="gt-card" aria-expanded="false">
                  <span class="leg-name">{s.name}</span>
                  <span class="leg-mi">
                    {i === 0 ? 'Start' : `+${Math.round(route.main.legs[i - 1].mi)} mi · ${route.main.legs[i - 1].min} min`}
                  </span>
                </button>
              </li>
            ))}
            <li>
              <button type="button" class="gt-leg" data-stop="starbase" aria-controls="gt-card" aria-expanded="false">
                <span class="leg-name">Starbase</span>
                <span class="leg-mi">Recon · {Math.round(route.recon.distanceMi)} mi round trip</span>
              </button>
            </li>
          </ol>
          <div class="figure">
            <TripMap kind="route" label={`Map of the ${totalMi}-mile driving route from Austin to South Padre Island via US-77`} />
            <GroundTrackStops />
          </div>
        </div>
      </div>
    </section>

    <section id="plan">
      <div class="wrap">
        <p class="eyebrow">03 · Flight plan</p>
        <h2>Four days, counted down</h2>
        <p class="lede">
          Austin, the drive, the launch, the drive home. Days are counted from launch day (L‑0); if the launch slips, the
          plan slides with it.
        </p>
        <ol class="strip mono" aria-hidden="true">
          {plan.map((d) => (
            <li class:list={{ launch: d.t === 'L-0' }}><span>{d.day}</span>{d.title.split(' · ')[0]}</li>
          ))}
          <li class="out"><span>{departure.day}</span>{departure.title}</li>
        </ol>
        <ol class="timeline">
          {plan.map((d) => (
            <li class="day">
              <div class="mono">
                <div class="t">{d.day}</div>
                <div class="l">{d.t}</div>
              </div>
              <div>
                <h3>{d.title}</h3>
                <p class="where mono">{d.where}</p>
                <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
        <aside class="day departure" aria-label="Flight home">
          <div class="mono">
            <div class="t">{departure.day}</div>
            <div class="l">{departure.t}</div>
          </div>
          <div>
            <h3>{departure.title}</h3>
            <p>{departure.text}</p>
          </div>
        </aside>
      </div>
    </section>

    <section id="viewing">
      <div class="wrap split">
        <div>
          <p class="eyebrow">04 · Viewing geometry</p>
          <h2>Close the day before, across the water on the day</h2>
          <p class="lede">
            The evening before, Highway 4 takes us right up to the pads and the factory. On launch day the city of
            Starbase closes the road and the beach, so we watch from the tip of South Padre Island, the closest public
            spot. There is no bridge across the pass, so the hotel is on the island.
          </p>
        </div>
        <div class="figure">
          <TripMap kind="viewing" label="Satellite map of Starbase, the launch pads, Highway 4, the drive to the hotel, and Isla Blanca Park on South Padre Island" />
          <GroundTrackStops set="viewing" />
        </div>
      </div>
    </section>

    <section id="manifest">
      <div class="wrap">
        <p class="eyebrow">05 · Launch manifest</p>
        <h2>The next three</h2>
        <p class="lede">
          SpaceX rarely confirms dates more than a few days ahead. Treat the first entry as a watch date, the second as a
          direction, and the third as a guess. Last updated <span class="mono">{launches.updatedAt}</span>.
        </p>
        <div class="grid manifest">
          {launches.upcoming.map((l, i) => (
            <article class:list={['card', 'flight', { off: !l.texas }]}>
              <p class="mono idx">{String(i + 1).padStart(2, '0')}{!l.texas && ' · not a Texas launch'}</p>
              <h3>{l.name}</h3>
              <p class="mono site">{l.site}</p>
              <p class="window">{l.window}</p>
              <div class="conf" aria-label={`Confidence: ${confidenceLabel[l.confidence]}`}>
                {[1, 2, 3, 4].map((n) => <span class:list={{ on: n <= confidenceLevel[l.confidence] }} />)}
                <span class="mono">{confidenceLabel[l.confidence]}</span>
              </div>
              <p class="note">{l.headline}</p>
              {l.source && <a class="mono src" href={l.source} rel="noopener" target="_blank">Source ↗</a>}
            </article>
          ))}
        </div>
        <p class="last mono">
          Last flight · {launches.lastFlight.name} · {launches.lastFlight.date} · {launches.lastFlight.summary}
        </p>
      </div>
    </section>

    <section id="vehicles">
      <div class="wrap">
        <p class="eyebrow">06 · Vehicles</p>
        <h2>Stage zero and stage one</h2>
        <div class="grid two">
          <div class="card">
            <p class="mono idx">Ground segment</p>
            <h3>Cybertruck</h3>
            <p>
              Stainless-steel body, seats five: four guests plus the driver. It handles the {totalMi} miles with one
              Supercharger stop and has plenty of room in the bed for boots.
            </p>
          </div>
          <div class="card">
            <p class="mono idx">Flight segment</p>
            <h3>Starship + Super Heavy</h3>
            <p>
              Stainless steel and about 124 meters tall: the largest rocket ever flown. Super Heavy returns to be
              caught by the tower's arms, nicknamed the chopsticks, and SpaceX may soon try catching the Ship too.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="checklist">
      <div class="wrap">
        <p class="eyebrow">07 · Pre-flight checklist</p>
        <h2>Before you book</h2>
        <ul class="checks">
          {checklist.map(([k, v]) => (
            <li><span class="mono go">GO</span><strong>{k}</strong><span>{v}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="crew">
      <div class="wrap split">
        <div>
          <p class="eyebrow">08 · Crew manifest</p>
          <h2>Request a seat</h2>
          <p class="lede">
            This trip is a perk of being a friend, not a tour. Tell me you're interested and I'll email you whenever the
            launch estimate moves, so you can book your flight once the date firms up.
          </p>
          <p class="lede mono small">You cover your flight, your room, and your share of the brisket. The ride is free.</p>
        </div>
        <SignupForm />
      </div>
    </section>
  </main>

  <footer class="wrap foot mono">
    <span>★ 77 to Starbase</span>
    <span>Not affiliated with SpaceX, Tesla, or Buc-ee's.</span>
    <span>
      Cybertruck model: <a href="https://sketchfab.com/3d-models/tesla-cybertruck-587a0833e60f465090145b139f6c1bfc">“Tesla Cybertruck”</a>
      by <a href="https://sketchfab.com/jnanbr07">Sketcher</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
    </span>
    <span>
      Music: <a href="https://opengameart.org/content/space-atmospere">“Space Atmosphere”</a> by Alexandr Zhelanov,
      <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>, transcoded and level-adjusted. “Drifter” by
      James Gargette (CC0).
    </span>
    <span class="egg" title="All systems nominal">Range is green</span>
  </footer>
</Base>

<script>
  const el = document.querySelector<HTMLElement>('.countdown');
  if (el?.dataset.net) {
    const target = new Date(`${el.dataset.net}T07:00:00-05:00`).getTime();
    const clock = el.querySelector('.clock')!;
    const tick = () => {
      const ms = Math.max(0, target - Date.now());
      const d = Math.floor(ms / 864e5);
      const h = Math.floor((ms % 864e5) / 36e5);
      const m = Math.floor((ms % 36e5) / 6e4);
      clock.innerHTML = `T−${d}<small>d</small> ${String(h).padStart(2, '0')}<small>h</small> ${String(m).padStart(2, '0')}<small>m</small>`;
    };
    tick();
    setInterval(tick, 30_000);
  }
  console.log('%c★ 77 → STARBASE  ·  Range is green. Go for launch.', 'color:#e8622c;font-weight:700');
</script>

<style>
  .hero {
    position: relative;
    min-height: clamp(640px, 100vh, 960px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .hero-copy { position: relative; z-index: 1; margin-top: 10vh; padding-bottom: 170px; width: 100%; pointer-events: none; }
  .hero-copy a, .hero-copy button { pointer-events: auto; }
  .hero-eyebrow { margin: 0 0 18px; }
  .hero-lede { font: 400 var(--fs-body) / 1.55 var(--body); color: var(--hud-2); max-width: 34ch; }
  h1 { font-size: var(--fs-display); font-weight: 700; letter-spacing: 0.03em; line-height: 0.92; }
  .host-chip {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    padding: 4px 16px 4px 4px;
    border: 1px solid rgba(242, 242, 242, 0.28);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    color: var(--hud-2);
    font-size: 0.9rem;
    text-decoration: none;
    text-shadow: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .host-chip img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; object-position: 50% 22%; }
  .host-chip b { color: var(--hud-1); font-weight: 600; }
  .host-chip:hover { border-color: var(--sunset); color: var(--hud-1); }
  .countdown { margin-top: 28px; display: grid; gap: 6px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }
  .hero .btn { font-size: var(--fs-label); letter-spacing: var(--track-caps); padding: 15px 28px; }
  .hero .btn:not(.primary) { background: rgba(0, 0, 0, 0.35); border-color: rgba(242, 242, 242, 0.45); }
  .hero .btn:not(.primary):hover { background: var(--hud-1); }

  .figure { margin-top: 56px; border: 1px solid var(--line); background: #050505; }

  .route-grid { display: grid; grid-template-columns: 280px 1fr; gap: 40px; margin-top: 56px; align-items: start; }
  .route-grid .figure { margin-top: 0; }
  .legs { list-style: none; margin: 0; padding: 0; position: sticky; top: calc(var(--nav-h) + 24px); }
  .legs li {
    display: grid;
    gap: 2px;
    padding: 14px 0 14px 22px;
    border-left: 1px solid var(--line);
    position: relative;
  }
  .legs li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 20px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sunset);
  }
  .leg-name { font-family: var(--display); font-size: 1.1rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .leg-mi { font-size: 0.75rem; color: var(--muted); }

  .timeline { list-style: none; padding: 0; margin: 56px 0 0; }
  .day {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .day .t { font-size: 1.6rem; color: var(--sunset); font-weight: 600; }
  .day .l { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.14em; margin-top: 4px; }
  .departure { border-bottom: 1px solid var(--line); opacity: 0.8; }
  .departure .t { color: var(--muted); }
  .departure p { margin: 8px 0 0; color: #cfcfd3; max-width: 70ch; }

  .strip { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(4, 1fr) 0.7fr; }
  .strip li {
    position: relative;
    padding: 18px 12px 0 0;
    border-top: 2px solid var(--sunset);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cfcfd3;
  }
  .strip li::before {
    content: '';
    position: absolute;
    left: 0;
    top: -6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sunset);
  }
  .strip li.launch::before { background: var(--go); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.06); }
  .strip li.out { border-top: 2px dashed var(--line); color: var(--muted); }
  .strip li.out::before { background: transparent; border: 1px solid var(--muted); }
  .strip span { display: block; color: var(--muted); margin-bottom: 4px; }
  .day .where { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 6px 0 12px; }
  .day ul { margin: 0; padding-left: 18px; color: #cfcfd3; }
  .day li + li { margin-top: 6px; }

  .split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 56px; align-items: center; }
  .split .figure { margin-top: 0; }

  .manifest { grid-template-columns: repeat(3, 1fr); margin-top: 56px; }
  .flight.off { opacity: 0.55; }
  .idx { font-size: 0.75rem; letter-spacing: 0.16em; color: var(--muted); text-transform: uppercase; margin: 0 0 12px; }
  .site { font-size: 0.8rem; color: var(--muted); margin: 6px 0 18px; }
  .window { font-family: var(--display); font-size: 1.5rem; letter-spacing: 0.04em; margin: 0; }
  .conf { display: flex; align-items: center; gap: 4px; margin: 14px 0; }
  .conf > span:not(.mono) { width: 22px; height: 4px; background: var(--line); }
  .conf > span.on { background: var(--sunset); }
  .conf .mono { font-size: 0.72rem; color: var(--muted); margin-left: 10px; text-transform: uppercase; letter-spacing: 0.1em; }
  .note { color: #cfcfd3; font-size: 0.95rem; }
  .src { font-size: 0.75rem; color: var(--muted); }
  .last { margin-top: 28px; color: var(--muted); font-size: 0.8rem; }

  .two { grid-template-columns: 1fr 1fr; margin-top: 56px; }
  .two h3 { margin-bottom: 12px; }
  .two p:not(.idx) { color: #cfcfd3; margin: 0; }

  .checks { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .checks li {
    display: grid;
    grid-template-columns: 44px 160px 1fr;
    gap: 12px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .go { color: var(--go); font-size: 0.8rem; }
  .checks strong { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500; }
  .checks li > span:last-child { color: var(--muted); font-size: 0.95rem; }

  .small { font-size: 0.85rem; }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 40px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .egg { color: var(--go); }

  @media (max-width: 900px) {
    .split, .two, .manifest, .checks, .route-grid { grid-template-columns: 1fr; }
    .legs { position: static; display: none; }
    .hero { min-height: 0; }
    .hero-copy { margin-top: 48px; padding-bottom: 0; }
    .day { grid-template-columns: 1fr; gap: 8px; }
    .day > .mono { display: flex; align-items: baseline; gap: 12px; }
    .strip li { font-size: 0.62rem; letter-spacing: 0.08em; padding-right: 6px; }
    .checks li { grid-template-columns: 44px 1fr; }
    .checks li > span:last-child { grid-column: 2; }
  }
</style>
