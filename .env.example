# Signup API URL from the infra stack output (public, not a secret)
PUBLIC_SIGNUP_ENDPOINT=

# AWS for scripts/ (deploy, broadcast, telegram-setup). Name a profile from ~/.aws, or leave it unset and provide
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the environment instead. Never put keys in this file.
AWS_PROFILE=
AWS_REGION=us-east-1
